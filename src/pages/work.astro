---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import CopyEmail from '../components/CopyEmail.astro';
import Icon from '../components/Icon.astro';
import { ArrowRight02Icon } from '../data/icons';
import { projects } from '../data/work';
/* No tabs, sort or filters: three projects scan faster than a panel that sorts them.
   They earn a filter back once the grid runs past a screen. */
---
<Base
  title="Work"
  description="Products Christopher Rosso made end to end: Plazuela, a live marketplace, and Petzone, the point of sale running a pet retail store in Itagui, Colombia. Brand, product design, web and the software underneath."
>
  <section class="workhead">
    <h1 class="display">Brand, product and software, <em>end to end</em>.</h1>
    <p class="lede">Every one of these is mine from the name down to the code. Two are live right now, running for people who are not me.</p>
  </section>

  <div class="grid">
    {projects.map((p) => <WorkCard project={p} />)}
  </div>

  <!-- Someone who has just looked through the work is the likeliest to write. Give them the door. -->
  <section class="section" data-reveal>
    <div class="section__head"><h2 class="h2">Work with me</h2><span class="eyebrow">Next</span></div>
    <p class="lede">Tell me what you're building and I'll tell you what it costs and when it ships.</p>
    <p class="work__cta">
      <a class="btn" href="mailto:chrisrossonyc@gmail.com?subject=New%20project">Start a project <Icon icon={ArrowRight02Icon} size={16} strokeWidth={2} /></a>
      <CopyEmail class="btn btn--ghost" />
    </p>
  </section>
</Base>

<style>
  .workhead { max-width: 760px; margin-bottom: 44px; display: flex; flex-direction: column; gap: 18px; }
  .workhead .display { font-size: clamp(34px, 4.2vw, 54px); }
  .work__cta { margin-top: 20px; display: flex; flex-wrap: wrap; gap: 12px; }
</style>
