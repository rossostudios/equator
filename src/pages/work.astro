---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { projects } from '../data/work';
---
<Base title="Work" filters={true}>
  <div class="active" id="active-filters" hidden>
    <span class="muted">Showing</span>
    <span class="active__chips" id="active-chips"></span>
    <button class="active__clear muted" id="active-clear">Clear</button>
  </div>
  <div class="grid" id="work-grid">
    {projects.map((p) => <WorkCard project={p} />)}
  </div>
  <p class="empty muted" id="empty" hidden>Nothing here yet.</p>
</Base>

<style>
  .active { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: -12px 0 24px; font-size: 14px; }
  .active[hidden] { display: none; }
  .active__chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .active__chips :global(.chip) { padding: 5px 10px; font-size: 13px; background: var(--fg); color: #fff; }
  .active__clear { padding: 4px 6px; }
  .active__clear:hover { color: var(--fg); }
  .empty { padding: 64px 0; text-align: center; }
</style>

<script>
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const toggle = $<HTMLButtonElement>('filter-toggle');
  const pop = $('filter-popover');
  const sort = $<HTMLSelectElement>('filter-sort');
  const search = $<HTMLInputElement>('filter-search');
  const chips = [...pop.querySelectorAll<HTMLButtonElement>('[data-chip]')];
  const nomatch = $('filter-nomatch');
  const grid = $('work-grid');
  const cards = [...grid.querySelectorAll<HTMLElement>('.card')];
  const empty = $('empty');
  const active = $('active-filters');
  const activeChips = $('active-chips');

  const viewBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-view]')];
  let view = 'popular';
  let selected = new Set<string>();
  let applied = new Set<string>();

  const openPop = (open: boolean) => {
    pop.toggleAttribute('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    if (open) { selected = new Set(applied); paintChips(); search.value = ''; filterChips(); search.focus(); }
  };
  const paintChips = () => chips.forEach((c) => c.setAttribute('aria-pressed', String(selected.has(c.dataset.chip!))));
  const filterChips = () => {
    const q = search.value.trim().toLowerCase();
    let n = 0;
    chips.forEach((c) => { const hit = !q || c.dataset.chip!.includes(q); c.toggleAttribute('hidden', !hit); if (hit) n++; });
    nomatch.toggleAttribute('hidden', n > 0);
  };
  const apply = () => {
    applied = new Set(selected);
    const s = view === 'wip' ? sort.value : view;
    const keyed = cards.map((c) => ({ c, tags: (c.dataset.tags + ',' + c.dataset.category!.toLowerCase()).split(','), likes: +c.dataset.likes!, year: +c.dataset.year!, title: c.dataset.title!, wip: c.dataset.status === 'wip' }));
    keyed.sort((a, b) => s === 'popular' ? b.likes - a.likes : s === 'recent' ? b.year - a.year || b.likes - a.likes : a.title.localeCompare(b.title));
    let shown = 0;
    for (const k of keyed) {
      const show = (view !== 'wip' || k.wip) && (applied.size === 0 || [...applied].some((t) => k.tags.includes(t)));
      k.c.style.display = show ? '' : 'none';
      if (show) shown++;
      grid.appendChild(k.c);
    }
    empty.toggleAttribute('hidden', shown > 0);
    activeChips.innerHTML = '';
    for (const t of applied) { const el = document.createElement('span'); el.className = 'chip'; el.textContent = t; activeChips.appendChild(el); }
    active.toggleAttribute('hidden', applied.size === 0);
    if (!pop.hasAttribute('hidden')) openPop(false);
  };

  viewBtns.forEach((b) => b.addEventListener('click', () => {
    view = b.dataset.view!;
    viewBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    if (view !== 'wip') sort.value = view;
    apply();
  }));

  const initial = new URLSearchParams(location.search).get('tag');
  if (initial) { selected.add(initial.toLowerCase()); apply(); }

  toggle.addEventListener('click', () => openPop(pop.hasAttribute('hidden')));
  chips.forEach((c) => c.addEventListener('click', () => { const k = c.dataset.chip!; selected.has(k) ? selected.delete(k) : selected.add(k); paintChips(); }));
  search.addEventListener('input', filterChips);
  $('filter-clear').addEventListener('click', () => { selected.clear(); paintChips(); });
  $('filter-apply').addEventListener('click', apply);
  $('active-clear').addEventListener('click', () => { selected.clear(); apply(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !pop.hasAttribute('hidden')) openPop(false); });
  document.addEventListener('click', (e) => {
    if (pop.hasAttribute('hidden')) return;
    if (!(e.target as HTMLElement).closest('.filter')) openPop(false);
  });
</script>
