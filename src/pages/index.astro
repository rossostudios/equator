---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import IdCard from '../components/IdCard.astro';
import Glyph from '../components/Glyph.astro';
import {
  ArrowRight02Icon,
  ArtboardIcon, BrowserIcon, Rocket01Icon, ShoppingBag02Icon, PuzzleIcon,
  Blockchain01Icon, Flowchart01Icon, AiSearchIcon, Film01Icon,
} from '../data/icons';
import WorkCard from '../components/WorkCard.astro';
import Blocks from '../components/Blocks.astro';
import Mark from '../components/Mark.astro';
import { projects } from '../data/work';
const featured = projects;
/* Proof beats promises, and a thing you can open beats both. Anything shipped
   with a public URL is something a stranger can verify without asking me. */
const live = projects.filter((p) => p.status === 'shipped' && p.url);

/* Only the Equator mark is hand-drawn. Everything generic comes from Hugeicons,
   which draws a tag or a puzzle piece better than I will freehand. */
const services: { title: string; body: string; tone: string; glyph?: any; icon?: any; accent: string; swatch: string[]; tag?: string }[] = [
  { title: 'Brand identity', glyph: 'brand', accent: 'var(--sun)', tone: 'paper', swatch: ['#101010', '#ff6b1a', '#ffb020'], body: "Logo, palette, type, the whole kit. Built for the sizes you'll actually use it at, favicon to storefront sign." },
  { title: 'Product design', icon: ArtboardIcon, accent: 'var(--sky)', tone: 'paper', swatch: ['#8898ff', '#ff6b1a', '#ffb020'], body: "Screens, flows, states. The happy path and everything that happens when it breaks." },
  { title: 'Websites', icon: BrowserIcon, accent: 'var(--amber)', tone: 'paper', swatch: ['#ffb020', '#8898ff', '#ff6b1a'], body: "Landing pages, marketing sites, portfolios. Designed and built, live on your domain." },
  { title: 'Build & ship', icon: Rocket01Icon, accent: 'var(--sun)', tone: 'ink', swatch: ['#ff6b1a', '#ffb020', '#8898ff'], body: "I turn designs into working software. Staging link early, and you can click it as it grows." },
  { title: 'Commerce & Shopify', icon: ShoppingBag02Icon, accent: 'var(--blush)', tone: 'paper', swatch: ['#ff9ec4', '#ff6b1a', '#ffb020'], body: "Store builds and fixes. Checkout, payments, and the edge cases that quietly cost sales." },
  { title: 'Browser tools', icon: PuzzleIcon, accent: 'var(--sky)', tone: 'paper', swatch: ['#8898ff', '#ff9ec4', '#ff6b1a'], body: "Small utilities for repetitive work. Built fast, installed the same week." },
  { title: 'Onchain products', icon: Blockchain01Icon, accent: 'var(--deep)', tone: 'paper', swatch: ['#0f332b', '#8898ff', '#ffb020'], body: "Wallets, contracts, dApps. Built so the keys stay yours." },
  { title: 'Systems & operations', icon: Flowchart01Icon, accent: 'var(--sun)', tone: 'paper', swatch: ['#ff6b1a', '#8898ff', '#101010'], body: "Notion or Monday setups. Tasks, owners, dates, so nobody guesses what's done." },
  { title: 'Agentic SEO', icon: AiSearchIcon, accent: 'var(--amber)', tone: 'paper', swatch: ['#ffb020', '#ff9ec4', '#101010'], body: "Pages tuned to what AI assistants say about your business. Checked monthly." },
  { title: 'Motion & video', icon: Film01Icon, accent: 'var(--blush)', tone: 'paper', swatch: ['#ff9ec4', '#8898ff', '#ff6b1a'], body: "Product video and animation, AI-assisted, the product consistent frame to frame.", tag: 'Developing' },
];
---
<Base
  title="Product design, brand and web development"
  description="Christopher Rosso makes whole products alone: the name, the brand identity, the product design, the website and the software underneath. Two are live now, plazuela.app and petzone-coral.vercel.app. English and Spanish, from Medellin."
>
  <section class="hero">
    <div class="hero__text">
    <p class="eyebrow hero__eyebrow" data-reveal style="--d:0">Equator · Design & development studio</p>
    <h1 class="display" data-reveal style="--d:1">What you describe is what <em>ships</em>.</h1>
    <p class="lede" data-reveal style="--d:2">The equator is where the sun comes straight down, no tilt, no shadow, nothing skewed between the sky and the ground. Same deal here. Your idea arrives intact and leaves as a live site, a working product, a brand that holds up. No committee, no drift, no version that nobody drew.</p>
    <div class="hero__cta" data-reveal style="--d:3">
      <a class="btn" href="mailto:chrisrossonyc@gmail.com">Tell me what you're building <Icon icon={ArrowRight02Icon} size={16} strokeWidth={2} /></a>
      <a class="link hero__alt" href="#proof">or open something I made</a>
    </div>
    <p class="hero__proof muted" data-reveal style="--d:4"><a class="link" href="/work/plazuela">Plazuela</a> and <a class="link" href="/work/petzone">Petzone</a>, both live and in use · English &amp; Spanish · I reply within the hour</p>
    </div>
    <div class="hero__card" data-reveal style="--d:3"><IdCard /></div>
  </section>

  <section class="section">
    <div class="section__head" data-reveal><h2 class="h2">What you get</h2><span class="eyebrow">The offer</span></div>
    <div class="offer">
      <ul class="offer__stack" data-reveal>
        <li>A staging link in week one, before the first page is finished.</li>
        <li>Everything in your name: repo, domain, design files, font licenses.</li>
        <li>Post-launch fixes without a new invoice per line.</li>
        <li>One person who answers, in English or Spanish, within the hour.</li>
      </ul>
      <aside class="offer__card" data-reveal>
        <span class="offer__band"><Blocks seed={88} cols={16} rows={2} palette={['#ff6b1a', '#ffb020', '#ff9ec4']} stretch /></span>
        <div class="offer__inner">
          <p class="offer__price">Tasks from <strong>$50 an hour</strong>. Projects quoted within a day of our first call.</p>
          <p class="offer__honest">If your deadline won't fit, you'll hear it before you pay anything.</p>
          <a class="btn" href="mailto:chrisrossonyc@gmail.com">Tell me what you're building <Icon icon={ArrowRight02Icon} size={16} strokeWidth={2} /></a>
          <p class="offer__contact"><a href="mailto:chrisrossonyc@gmail.com">chrisrossonyc@gmail.com</a><br />Medellín / remote · Eastern time, give or take a country</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="section__head" data-reveal><h2 class="h2">What I do</h2><span class="eyebrow">Services</span></div>
    <div class="services">
      {services.map((s, i) => (
        <div class:list={['service', `service--${s.tone}`]} data-reveal style={`--d:${i % 5}`}>
          <span class="service__glyph" style={`color:${s.accent}`}>
            {s.glyph ? <Glyph name={s.glyph} size={30} strokeWidth={1.4} /> : <Icon icon={s.icon} size={30} strokeWidth={1.4} />}
          </span>
          <h3>{s.title}</h3>
          <p class="service__body">{s.body}</p>
          {s.tag && <span class="service__tag">{s.tag}</span>}
        </div>
      ))}
    </div>
  </section>

  <section class="section" id="proof">
    <div class="section__head" data-reveal><h2 class="h2">Don't take my word for it</h2><a class="link muted" href="/work">All projects</a></div>
    <p class="lede work__note" data-reveal>{live.length} of these are running right now, for people who are not me. Open one and click around.</p>
    <p class="work__open" data-reveal>
      {live.map((p) => (
        <a class="btn btn--ghost" href={p.url} target="_blank" rel="noopener noreferrer">
          Open {p.title} <Icon icon={ArrowRight02Icon} size={15} strokeWidth={2} />
        </a>
      ))}
    </p>
    <div class="grid">{featured.map((p) => <WorkCard project={p} />)}</div>
  </section>

  <div class="horizon" data-reveal aria-hidden="true">
    <Blocks mode="horizon" seed={34} cols={22} rows={14} class="horizon__blocks" />
    <Mark class="horizon__mark" />
  </div>

  <footer class="footer muted">
    <Mark class="footer__mark" />
    <span>Tell me what you're building and I'll tell you what it costs and when it ships.</span>
  </footer>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 3fr 2fr; gap: 64px; align-items: center; padding-top: 8px; }
  .hero__eyebrow { margin-bottom: 20px; }
  .hero__proof { margin-top: 32px; font-size: 14px; }
  .hero .display { font-size: clamp(40px, 5.1vw, 68px); }
  .hero .lede { max-width: 56ch; }
  .hero__text { min-width: 0; }
  .hero__card { height: 620px; width: 100%; max-width: 460px; justify-self: center; }
  .hero .lede { margin-top: 24px; }
  .hero__cta { display: flex; gap: 10px; margin-top: 36px; flex-wrap: wrap; }
  .services { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 24px; }
  /* Each card is a colour block with one monoline glyph. Tones are assigned per
     service so the two dark blocks fall apart across the grid instead of pairing up. */
  .service {
    padding: 22px; border-radius: var(--radius); min-height: 210px;
    display: flex; flex-direction: column; gap: 10px;
    background: var(--tone); color: var(--tone-ink); border: 1px solid transparent;
    transition: transform .25s cubic-bezier(.2,.8,.2,1), box-shadow .3s ease;
  }
  .service:hover { transform: translateY(-3px); box-shadow: 0 20px 40px -26px rgba(0,0,0,.5); }
  .service--paper { --tone: var(--surface); --tone-ink: var(--fg); border-color: var(--line); }
  .service--sun   { --tone: var(--sun);   --tone-ink: #101010; }
  .service--amber { --tone: var(--amber); --tone-ink: #101010; }
  .service--sky   { --tone: var(--sky);   --tone-ink: #101010; }
  .service--ink   { --tone: var(--fg);    --tone-ink: var(--bg); }
  .service--deep  { --tone: var(--deep);  --tone-ink: #ffffff; }
  /* The glyph carries the colour; the card stays quiet behind it. */
  .service__glyph { display: block; height: 30px; margin-bottom: 10px; }
  .service__glyph :global(svg) { display: block; }
  .service--ink .service__glyph { color: var(--sun) !important; }
  .service h3 { font-size: 17px; font-weight: 600; }
  .service__body { font-size: 15px; opacity: .8; }
  .service__tag {
    margin-top: auto; align-self: flex-start; font-size: 11px; font-weight: 600;
    letter-spacing: .1em; text-transform: uppercase; opacity: .6;
  }
  .contact { margin-top: 18px; font-size: 17px; }
  .hero__alt { font-size: 15px; align-self: center; }

  /* The work grid carries the proof, so the demonstration sits above it. */
  .work__note { max-width: 52ch; margin-bottom: 18px; }
  .work__open { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 30px; }

  /* The offer is a stack: everything you get, listed, before any number appears.
     The terms sit on ink so the CTA is the brightest thing in the section. */
  .offer { display: grid; grid-template-columns: 1.05fr .95fr; gap: 40px; align-items: start; }
  .offer__stack { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0; }
  .offer__stack li {
    position: relative; padding: 15px 0 15px 30px; font-size: 16px; line-height: 1.55;
    border-bottom: 1px solid var(--line);
  }
  .offer__stack li:first-child { padding-top: 0; }
  .offer__stack li:last-child { border-bottom: 0; }
  .offer__stack li::before {
    content: ""; position: absolute; left: 0; top: 22px; width: 15px; height: 7px;
    background: var(--sun); -webkit-mask: var(--marker) center / contain no-repeat;
    mask: var(--marker) center / contain no-repeat;
  }
  .offer__stack li:first-child::before { top: 7px; }
  .offer__card { overflow: hidden; border-radius: var(--radius); background: var(--fg); color: var(--bg); }
  .offer__band { display: block; height: 12px; }
  .offer__band :global(svg) { width: 100%; height: 100%; display: block; }
  .offer__inner { padding: 28px; display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  .offer__price { font-size: 16px; line-height: 1.6; color: color-mix(in srgb, var(--bg) 72%, var(--fg)); }
  .offer__price strong { color: var(--bg); font-weight: 600; }
  .offer__honest { font-size: 14px; line-height: 1.6; color: color-mix(in srgb, var(--bg) 52%, var(--fg)); }
  .offer__card .btn { background: var(--bg); color: var(--fg); }
  .offer__card .btn:hover { background: var(--sun); color: #fff; }
  .offer__contact { font-size: 13px; line-height: 1.7; color: color-mix(in srgb, var(--bg) 45%, var(--fg)); }
  .offer__contact a { color: color-mix(in srgb, var(--bg) 72%, var(--fg)); border-bottom: 1px solid color-mix(in srgb, var(--bg) 35%, var(--fg)); }
  .offer__contact a:hover { color: var(--bg); border-color: var(--bg); }

  /* Sky to sun to ground, with the scanlines the reference uses to age the gradient. */
  .horizon {
    position: relative; margin-top: 96px; height: clamp(220px, 26vw, 340px);
    border-radius: 24px; overflow: hidden; display: grid; place-items: center;
  }
  .horizon :global(.horizon__blocks) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .horizon :global(.horizon__mark) { position: relative; width: clamp(64px, 8vw, 96px); height: auto; color: #fff; }
  .footer { margin-top: 28px; padding-top: 24px; font-size: 13px; display: flex; align-items: center; justify-content: center; gap: 12px; }
  @media (max-width: 1560px) { .services { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 1100px) { .services { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 1260px) { .hero { gap: 40px; } .hero__card { height: 540px; } }
  @media (max-width: 1000px) { .hero { grid-template-columns: 1fr; gap: 32px; } .hero__card { width: 100%; height: 520px; max-width: 420px; margin: 0; } }
  @media (max-width: 760px) {
    .services, .offer { grid-template-columns: 1fr; }
  }
</style>






