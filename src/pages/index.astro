---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import IdCard from '../components/IdCard.astro';
import Tools from '../components/Tools.astro';
import { ArrowRight02Icon } from '@hugeicons/core-free-icons';
import WorkCard from '../components/WorkCard.astro';
import { projects } from '../data/work';
const featured = projects;
const services = [
  ['Brand identity', 'A mark, a voice and a system that make a small company feel like a sure thing.'],
  ['Product design', 'Interfaces that get out of the way. From the first sketch to the shipped component.'],
  ['Websites', 'Hand-built on Astro and Next.js. Fast, accessible, and yours to keep.'],
  ['Build & ship', 'I write the code too, so what you approve is what goes live. No handoff gap.'],
];
const chapters = [
  ['Roots', 'Family business', 'Blue-collar work in New Jersey. Learned to show up early, fix what is broken, and finish the job.'],
  ['Self-taught', 'IT management', 'Taught myself to run the systems small businesses depend on. Networks, hardware, the people using them.'],
  ['Now', 'Design & software', 'Learned to code by building, one project at a time. Today I design and ship products with AI in the loop, currently from the road in South America.'],
];
---
<Base title="Christopher, designer & developer">
  <section class="hero">
    <div class="hero__text">
    <p class="eyebrow hero__eyebrow">Equator · Design & development studio</p>
    <h1 class="display">Brand, product and web design for small teams that need it built, not just drawn.</h1>
    <p class="lede">I'm Christopher, the designer and developer behind Equator. I design it, build it and ship it myself, so nothing gets lost between the mockup and the launch.</p>
    <div class="hero__cta">
      <a class="btn" href="mailto:chrisrossonyc@gmail.com">Start a project <Icon icon={ArrowRight02Icon} size={16} strokeWidth={2} /></a>
      <a class="btn btn--ghost" href="/work">See the work</a>
    </div>
    <p class="hero__proof muted">Recent work for <a class="link" href="/work/plazuela">Plazuela</a> and <a class="link" href="/work/petzone">Petzone</a> · Replies within the hour</p>
    </div>
    <div class="hero__card"><IdCard /></div>
  </section>

  <section class="section">
    <div class="section__head"><h2 class="h2">What I do</h2><span class="eyebrow">Services</span></div>
    <div class="services">
      {services.map(([t, d]) => (<div class="service"><h3>{t}</h3><p class="muted">{d}</p></div>))}
    </div>
  </section>

  <section class="section">
    <div class="section__head"><h2 class="h2">Selected work</h2><a class="link muted" href="/work">All projects</a></div>
    <div class="grid">{featured.map((p) => <WorkCard project={p} />)}</div>
  </section>

  <section class="section">
    <div class="section__head"><h2 class="h2">How I got here</h2><span class="eyebrow">Background</span></div>
    <ol class="chapters">
      {chapters.map(([tag, title, body]) => (<li><span class="eyebrow">{tag}</span><h3>{title}</h3><p class="muted">{body}</p></li>))}
    </ol>
  </section>

  <section class="section">
    <div class="section__head"><h2 class="h2">Tools I use and love</h2><span class="eyebrow">Stack</span></div>
    <Tools />
  </section>

  <section class="section about">
    <div>
      <div class="section__head"><h2 class="h2">Get in touch</h2><span class="eyebrow">Contact</span></div>
      <p class="lede">Taking on a few projects at a time. Email is fastest, and I answer within the hour.</p>
      <p class="contact"><a class="link" href="mailto:chrisrossonyc@gmail.com">chrisrossonyc@gmail.com</a></p>
      <p class="muted contact">Eastern time, give or take a country</p>
    </div>
    <div>
      <div class="section__head"><h2 class="h2">Merch</h2><span class="eyebrow">Coming soon</span></div>
      <p class="lede">Studio pass tees and a few things for the desk. Not ready yet, but the page is.</p>
      <p class="contact"><a class="btn btn--ghost" href="/merch">Peek at the merch page</a></p>
    </div>
  </section>

  <footer class="footer muted">© {new Date().getFullYear()} Equator. Made with Astro.</footer>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 3fr 2fr; gap: 64px; align-items: center; padding-top: 8px; }
  .hero__eyebrow { margin-bottom: 20px; }
  .hero__proof { margin-top: 32px; font-size: 14px; }
  .hero .display { font-size: clamp(34px, 4.4vw, 58px); }
  .hero .lede { max-width: 56ch; }
  .hero__text { min-width: 0; }
  .hero__card { height: 620px; width: 100%; max-width: 460px; justify-self: center; }
  .hero .lede { margin-top: 24px; }
  .hero__cta { display: flex; gap: 10px; margin-top: 36px; flex-wrap: wrap; }
  .services { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .service { padding: 24px; border: 1px solid var(--line); border-radius: var(--radius); min-height: 180px; display: flex; flex-direction: column; gap: 10px; transition: background .15s; }
  .service:hover { background: #fafafa; }
  .service h3 { font-size: 17px; font-weight: 600; }
  .about { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  .chapters { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; counter-reset: ch; }
  .chapters li { padding: 24px 0 0; border-top: 1px solid var(--fg); display: flex; flex-direction: column; gap: 10px; }
  .chapters h3 { font-size: 20px; font-weight: 600; letter-spacing: -.01em; }
  .chapters p { line-height: 1.6; }
  .contact { margin-top: 18px; font-size: 17px; }
  .footer { margin-top: 96px; padding-top: 24px; border-top: 1px solid var(--line); font-size: 13px; }
  @media (max-width: 1100px) { .services { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 1260px) { .hero { gap: 40px; } .hero__card { height: 540px; } }
  @media (max-width: 1000px) { .hero { grid-template-columns: 1fr; gap: 32px; } .hero__card { width: 100%; height: 520px; max-width: 420px; margin: 0; } }
  @media (max-width: 760px) { .services, .about { grid-template-columns: 1fr; } .chapters { grid-template-columns: 1fr; } }
</style>
