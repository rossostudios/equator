---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import IdCard from '../components/IdCard.astro';
import Glyph from '../components/Glyph.astro';
import { ArrowRight02Icon } from '../data/icons';
import WorkCard from '../components/WorkCard.astro';
import Blocks from '../components/Blocks.astro';
import Mark from '../components/Mark.astro';
import { projects } from '../data/work';
const featured = projects;
const services: { title: string; body: string; tone: string; glyph: any; accent: string; swatch: string[]; tag?: string }[] = [
  { title: 'Brand identity', glyph: 'brand', accent: 'var(--sun)', tone: 'paper', swatch: ['#101010', '#ff6b1a', '#ffb020'], body: 'I make the mark, the palette and the way of writing that let three people look like a company.' },
  { title: 'Product design', glyph: 'product', accent: 'var(--sky)', tone: 'paper', swatch: ['#8898ff', '#ff6b1a', '#ffb020'], body: 'I design screens you work out on the first try, with no tooltip explaining what the button does.' },
  { title: 'Websites', glyph: 'web', accent: 'var(--amber)', tone: 'paper', swatch: ['#ffb020', '#8898ff', '#ff6b1a'], body: 'Fast, accessible, and yours to keep. No page builder, nothing to renew, nobody to ask for the password.' },
  { title: 'Build & ship', glyph: 'build', accent: 'var(--sun)', tone: 'ink', swatch: ['#ff6b1a', '#ffb020', '#8898ff'], body: 'I turn the approved design into a link you can send people, then stay on for the parts nobody demos.' },
  { title: 'Commerce & Shopify', glyph: 'commerce', accent: 'var(--blush)', tone: 'paper', swatch: ['#ff9ec4', '#ff6b1a', '#ffb020'], body: 'Themes, apps and back-office tooling, built to hold up on your busiest Saturday.' },
  { title: 'Browser tools', glyph: 'extension', accent: 'var(--sky)', tone: 'paper', swatch: ['#8898ff', '#ff9ec4', '#ff6b1a'], body: 'I write Chrome extensions that delete the step your team does forty times a day.' },
  { title: 'Onchain products', glyph: 'onchain', accent: 'var(--deep)', tone: 'paper', swatch: ['#0f332b', '#8898ff', '#ffb020'], body: 'Wallets, contracts and onchain data — and an honest no when your product does not need a chain.' },
  { title: 'Systems & operations', glyph: 'pipeline', accent: 'var(--sun)', tone: 'paper', swatch: ['#ff6b1a', '#8898ff', '#101010'], body: 'I wire Notion, Monday, ClickUp or Asana into a pipeline that runs: intake, status, handoff, done.' },
  { title: 'Agentic SEO', glyph: 'target', accent: 'var(--amber)', tone: 'paper', swatch: ['#ffb020', '#ff9ec4', '#101010'], body: 'I write for the model that answers your customer before they ever reach a results page.' },
  { title: 'Motion & video', glyph: 'motion', accent: 'var(--blush)', tone: 'paper', swatch: ['#ff9ec4', '#8898ff', '#ff6b1a'], body: 'Product clips and launch cuts. Generative video, scenes that hold their look, stills that move.', tag: 'Developing' },
];
/** The studio is named after a line. The work has been a slow move toward it. */
---
<Base title="Christopher, designer & developer">
  <section class="hero">
    <div class="hero__text">
    <p class="eyebrow hero__eyebrow" data-reveal style="--d:0">Equator · Design & development studio</p>
    <h1 class="display" data-reveal style="--d:1">Designed, built, and <em>live</em>.</h1>
    <p class="lede" data-reveal style="--d:2">Brand identity, product design, websites, and the software underneath. Design and build happen in the same place, so what you approve is what opens on your customer's screen.</p>
    <div class="hero__cta" data-reveal style="--d:3">
      <a class="btn" href="mailto:chrisrossonyc@gmail.com">Start a project <Icon icon={ArrowRight02Icon} size={16} strokeWidth={2} /></a>
      <a class="btn btn--ghost" href="/work">See the work</a>
    </div>
    <p class="hero__proof muted" data-reveal style="--d:4">Recent work for <a class="link" href="/work/plazuela">Plazuela</a> and <a class="link" href="/work/petzone">Petzone</a> · Design, build and ops · English &amp; Spanish · I reply within the hour</p>
    </div>
    <div class="hero__card" data-reveal style="--d:3"><IdCard /></div>
  </section>

  <section class="section">
    <div class="section__head" data-reveal><h2 class="h2">What I do</h2><span class="eyebrow">Services</span></div>
    <div class="services">
      {services.map((s, i) => (
        <div class:list={['service', `service--${s.tone}`]} data-reveal style={`--d:${i % 5}`}>
          <span class="service__glyph" style={`color:${s.accent}`}><Glyph name={s.glyph} size={30} strokeWidth={1.4} /></span>
          <h3>{s.title}</h3>
          <p class="service__body">{s.body}</p>
          {s.tag && <span class="service__tag">{s.tag}</span>}
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section__head" data-reveal><h2 class="h2">Selected work</h2><a class="link muted" href="/work">All projects</a></div>
    <div class="grid">{featured.map((p) => <WorkCard project={p} />)}</div>
  </section>

  <section class="section about">
    <div>
      <div class="section__head" data-reveal><h2 class="h2">Get in touch</h2><span class="eyebrow">Contact</span></div>
      <p class="lede">I take a few projects at a time, so yours gets real weeks instead of leftovers. Email is fastest, and I answer within the hour.</p>
      <p class="contact"><a class="link" href="mailto:chrisrossonyc@gmail.com">chrisrossonyc@gmail.com</a></p>
      <p class="muted contact">English &amp; Spanish · Medellín / remote · Eastern time, give or take a country</p>
      <p class="muted contact">Tasks start at $50/hr. Projects are quoted by scope, once I understand it.</p>
    </div>
    <div>
      <div class="section__head" data-reveal><h2 class="h2">Merch</h2><span class="eyebrow">Coming soon</span></div>
      <p class="lede">Studio pass tees and a few things for the desk. Nothing is made yet, so there is nothing to sell.</p>
      <p class="contact"><a class="btn btn--ghost" href="/merch">Peek at the merch page</a></p>
    </div>
  </section>

  <div class="horizon" data-reveal aria-hidden="true">
    <Blocks mode="horizon" seed={34} cols={22} rows={14} class="horizon__blocks" />
    <Mark class="horizon__mark" />
  </div>

  <footer class="footer muted">
    <Mark class="footer__mark" />
    <span>© {new Date().getFullYear()} Equator. Design, build and the ops in between.</span>
  </footer>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 3fr 2fr; gap: 64px; align-items: center; padding-top: 8px; }
  .hero__eyebrow { margin-bottom: 20px; }
  .hero__proof { margin-top: 32px; font-size: 14px; }
  .hero .display { font-size: clamp(40px, 5.1vw, 68px); }
  .hero .lede { max-width: 56ch; }
  .hero__text { min-width: 0; }
  .hero__card { height: 620px; width: 100%; max-width: 460px; justify-self: center; }
  .hero .lede { margin-top: 24px; }
  .hero__cta { display: flex; gap: 10px; margin-top: 36px; flex-wrap: wrap; }
  .services { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 24px; }
  /* Each card is a colour block with one monoline glyph. Tones are assigned per
     service so the two dark blocks fall apart across the grid instead of pairing up. */
  .service {
    padding: 22px; border-radius: var(--radius); min-height: 210px;
    display: flex; flex-direction: column; gap: 10px;
    background: var(--tone); color: var(--tone-ink); border: 1px solid transparent;
    transition: transform .25s cubic-bezier(.2,.8,.2,1), box-shadow .3s ease;
  }
  .service:hover { transform: translateY(-3px); box-shadow: 0 20px 40px -26px rgba(0,0,0,.5); }
  .service--paper { --tone: var(--surface); --tone-ink: var(--fg); border-color: var(--line); }
  .service--sun   { --tone: var(--sun);   --tone-ink: #101010; }
  .service--amber { --tone: var(--amber); --tone-ink: #101010; }
  .service--sky   { --tone: var(--sky);   --tone-ink: #101010; }
  .service--ink   { --tone: var(--fg);    --tone-ink: #ffffff; }
  .service--deep  { --tone: var(--deep);  --tone-ink: #ffffff; }
  /* The glyph carries the colour; the card stays quiet behind it. */
  .service__glyph { display: block; height: 30px; margin-bottom: 10px; }
  .service__glyph :global(svg) { display: block; }
  .service--ink .service__glyph { color: var(--sun) !important; }
  .service h3 { font-size: 17px; font-weight: 600; }
  .service__body { font-size: 15px; opacity: .8; }
  .service__tag {
    margin-top: auto; align-self: flex-start; font-size: 11px; font-weight: 600;
    letter-spacing: .1em; text-transform: uppercase; opacity: .6;
  }
  .about { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  .contact { margin-top: 18px; font-size: 17px; }
  /* Sky to sun to ground, with the scanlines the reference uses to age the gradient. */
  .horizon {
    position: relative; margin-top: 96px; height: clamp(220px, 26vw, 340px);
    border-radius: 24px; overflow: hidden; display: grid; place-items: center;
  }
  .horizon :global(.horizon__blocks) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .horizon :global(.horizon__mark) { position: relative; width: clamp(64px, 8vw, 96px); height: auto; color: #fff; }
  .footer { margin-top: 28px; padding-top: 24px; font-size: 13px; display: flex; align-items: center; justify-content: center; gap: 12px; }
  @media (max-width: 1560px) { .services { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 1100px) { .services { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 1260px) { .hero { gap: 40px; } .hero__card { height: 540px; } }
  @media (max-width: 1000px) { .hero { grid-template-columns: 1fr; gap: 32px; } .hero__card { width: 100%; height: 520px; max-width: 420px; margin: 0; } }
  @media (max-width: 760px) {
    .services, .about { grid-template-columns: 1fr; }
  }
</style>






