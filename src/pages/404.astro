---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { ArrowRight02Icon } from '../data/icons';
/* Vercel serves dist/404.html for any address that does not exist, with the bar still on
   top, so a wrong turn is one click from anywhere real. One page serves both languages, so
   it stays in English with a line out for Spanish readers. */
---
<Base title="Page not found" description="There is nothing at this address on chrisrosso.dev." noindex alternate="/es/">
  <section class="lost">
    <div class="lost__text">
      <p class="eyebrow hero__eyebrow">Error 404</p>
      <h1 class="display">This step is missing.</h1>
      <p class="lede">There's nothing at <code class="lost__path" id="lost-path">this address</code>. It may have moved, or the link is wrong. Everything else is where it was.</p>
      <div class="lost__cta">
        <a class="btn" href="/">Back to home <Icon icon={ArrowRight02Icon} size={16} strokeWidth={2} /></a>
        <a class="btn btn--ghost" href="/work">See the work</a>
      </div>
      <p class="lost__report muted">Got here from a link on this site? <a class="link" id="lost-report" href="mailto:hello@chrisrosso.dev?subject=Broken%20link">Tell me</a> and I'll fix it.</p>
      <p class="lost__report muted" lang="es">¿Buscabas la versión en español? <a class="link" href="/es/">Ir al inicio</a></p>
    </div>
    <!-- Me in bricks, waving you back. -->
    <div class="portrait" id="portrait" aria-hidden="true"><canvas></canvas></div>
  </section>
</Base>

<style>
  .lost { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 40px; align-items: center; }
  .lost__text { min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 22px; }
  .lost .lede { max-width: 46ch; }
  .lost__path { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .86em; overflow-wrap: anywhere; }
  .lost__cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
  .lost__report { font-size: 14px; }
  .portrait { position: relative; height: clamp(380px, 40vw, 520px); cursor: grab; touch-action: pan-y; user-select: none; }
  .portrait canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; opacity: 0; transition: opacity .8s ease; }
  .portrait.is-ready canvas { opacity: 1; }
  .portrait.is-flat { display: none; }
  @media (max-width: 860px) {
    .lost { grid-template-columns: 1fr; gap: 0; }
    .portrait { height: 360px; }
  }
</style>

<script>
  // Say which address missed: it is the one thing on this page a visitor can act on.
  const path = (() => { try { return decodeURI(location.pathname); } catch { return location.pathname; } })();
  document.getElementById('lost-path')!.textContent = path;
  (document.getElementById('lost-report') as HTMLAnchorElement).href =
    `mailto:hello@chrisrosso.dev?subject=${encodeURIComponent('Broken link: ' + path)}`;
  const load = () => import('../scripts/portrait');
  if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 1200 });
  else setTimeout(load, 200);
</script>
