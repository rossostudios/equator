---
import '../../../styles/global.css';
import { Image, getImage } from 'astro:assets';
import Icon from '../../../components/Icon.astro';
import Cover from '../../../components/Cover.astro';
import Meta from '../../../components/Meta.astro';
import ThemeInit from '../../../components/ThemeInit.astro';
import CopyEmail from '../../../components/CopyEmail.astro';
import { type Project, projects, imageWidths, localize } from '../../../data/work';
import { testimonials } from '../../../data/testimonials';
import { Cancel01Icon, ArrowLeft02Icon, ArrowRight02Icon, PlayIcon, LinkSquare02Icon } from '../../../data/icons';
import { type Lang, langPaths, href } from '../../../i18n';
import { ui, mailto } from '../../../i18n/ui';

export function getStaticPaths() {
  return langPaths().flatMap(({ params, props }) =>
    projects.map((project) => ({ params: { ...params, slug: project.slug }, props: { ...props, project } })));
}
const { lang } = Astro.props as { lang: Lang; project: Project };
const p = localize(Astro.props.project, lang);
const u = ui[lang];
const h = (path: string) => href(lang, path);

const en = {
  eyebrow: 'Case study',
  back: 'Back to work',
  close: 'Close',
  prev: (title: string) => `Previous: ${title}`,
  next: (title: string) => `Next: ${title}`,
  facts: { client: 'Client', scope: 'Scope', year: 'Year', status: 'Status', live: 'Live', wip: 'In progress' },
  shipped: 'What shipped',
  tagged: 'Tagged',
  similar: 'Start something similar',
  zoom: (alt: string) => `View full size: ${alt}`,
  zoomDialog: 'Full-size screenshot',
  zoomClose: 'Close full-size view',
};
const es: typeof en = {
  eyebrow: 'Caso de estudio',
  back: 'Volver al trabajo',
  close: 'Cerrar',
  prev: (title: string) => `Anterior: ${title}`,
  next: (title: string) => `Siguiente: ${title}`,
  facts: { client: 'Cliente', scope: 'Alcance', year: 'Año', status: 'Estado', live: 'En vivo', wip: 'En proceso' },
  shipped: 'Qué se entregó',
  tagged: 'Etiquetas',
  similar: 'Empezar algo parecido',
  zoom: (alt: string) => `Ver en tamaño completo: ${alt}`,
  zoomDialog: 'Captura en tamaño completo',
  zoomClose: 'Cerrar la vista completa',
};
const t = { en, es }[lang];

const idx = projects.findIndex((x) => x.slug === p.slug);
const prev = projects[(idx - 1 + projects.length) % projects.length];
const next = projects[(idx + 1) % projects.length];
const quote = testimonials.find((q) => q.company === p.client);
const facts: [string, string][] = [
  [t.facts.client, p.client],
  [t.facts.scope, p.scope ?? u.category[p.category]],
  [t.facts.year, String(p.year)],
  [t.facts.status, p.status === 'wip' ? t.facts.wip : t.facts.live],
];
/* The stage is the window less the 440px panel and 48px of padding a side; below 960px
   it runs full width with 16px sides. The browser picks the image width from this. */
const stageSizes = '(max-width: 960px) calc(100vw - 32px), calc(100vw - 536px)';
/* Link previews use the first screenshot, cropped from the top to the 1.91:1 card every
   platform draws and flattened onto the white plate the renders were made for. A project
   without screenshots (Equator is a white mark on transparent) keeps the site card. */
const shareShot = p.gallery?.[0];
const share = shareShot
  ? await getImage({ src: shareShot.src, width: 1200, height: 630, fit: 'cover', position: 'top', format: 'jpeg', background: '#ffffff', quality: 85 })
  : undefined;
---
<!doctype html>
<html lang={lang}>
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Meta title={`${p.title} — Equator`} description={p.description} image={share?.src} imageAlt={shareShot?.alt} lang={lang} />
    <ThemeInit />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="detail">
    <section class="stage">
      <a class="stage__close" href={h('/work')} aria-label={t.back} data-tip={t.close} data-close><Icon icon={Cancel01Icon} size={22} /></a>
      <a class="stage__nav stage__nav--prev" href={h(`/work/${prev.slug}`)} aria-label={t.prev(prev.title)}><Icon icon={ArrowLeft02Icon} size={22} /></a>
      <a class="stage__nav stage__nav--next" href={h(`/work/${next.slug}`)} aria-label={t.next(next.title)}><Icon icon={ArrowRight02Icon} size={22} /></a>
      <div class="stage__scroll">
        {p.gallery ? (
          p.gallery.map((shot, i) => (
            <figure
              class="stage__media stage__media--shot"
              style={i === 0 ? `view-transition-name: cover-${p.slug}` : undefined}
              data-reveal={i === 0 ? undefined : true}
            >
              <button class="stage__zoom" type="button" aria-label={t.zoom(shot.alt)}>
                <Image src={shot.src} alt={shot.alt} widths={imageWidths} sizes={stageSizes} quality={85} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" />
              </button>
            </figure>
          ))
        ) : (
          <figure class="stage__media stage__media--cover" style={`view-transition-name: cover-${p.slug}`}>
            <Cover project={p} eager sizes={stageSizes} />
            {p.video && <span class="stage__play"><Icon icon={PlayIcon} size={28} strokeWidth={0} class="fill" /></span>}
          </figure>
        )}
      </div>
    </section>

    <aside class="panel">
      <div class="panel__intro">
        <header class="panel__head">
          <p class="eyebrow">{t.eyebrow}</p>
          <a class="iconbtn" href={h('/work')} aria-label={t.back} data-close><Icon icon={Cancel01Icon} size={18} /></a>
        </header>

        <h1 class="panel__title">{p.title}</h1>
        <p class="panel__desc">{p.description}</p>
        {p.url && <a class="panel__site" href={p.url} target="_blank" rel="noopener noreferrer"><Icon icon={LinkSquare02Icon} size={16} /> {p.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a>}
      </div>

      <div class="panel__rest">
        <dl class="facts">
          {facts.map(([label, value]) => (
            <div class="facts__row"><dt>{label}</dt><dd>{value}</dd></div>
          ))}
        </dl>

        {p.highlights && (
          <section class="panel__block">
            <h2 class="eyebrow">{t.shipped}</h2>
            <ul class="shipped">{p.highlights.map((h) => <li>{h}</li>)}</ul>
          </section>
        )}

        <section class="panel__block">
          <h2 class="eyebrow">{t.tagged}</h2>
          <div class="panel__tags">{p.tags.map((t) => <span class="chip chip--outline">{t}</span>)}</div>
        </section>

        {quote && (
          <figure class="panel__quote">
            <blockquote>{quote.quote}</blockquote>
            <figcaption class="muted">{quote.name} &middot; {quote.role}, {quote.company}</figcaption>
          </figure>
        )}

        <footer class="panel__foot">
          <a class="btn" href={mailto(u.subject.similar(p.title))}>{t.similar} <Icon icon={ArrowRight02Icon} size={16} strokeWidth={2} /></a>
          <CopyEmail class="btn btn--ghost" lang={lang} />
        </footer>
      </div>
    </aside>

    <dialog class="zoom" id="zoom" aria-label={t.zoomDialog}>
      <button class="zoom__close" type="button" aria-label={t.zoomClose}><Icon icon={Cancel01Icon} size={22} /></button>
      <div class="zoom__pan" tabindex="0"><img class="zoom__img" alt="" /></div>
    </dialog>

    <script>
      const shots = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
        shots.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0 },
        );
        shots.forEach((el) => io.observe(el));
        setTimeout(() => {
          if (!document.querySelector('[data-reveal].is-in')) shots.forEach((el) => el.classList.add('is-in'));
        }, 3000);
      }

      /* Close returns to wherever on the site the visitor came from, the homepage or the
         grid, with its scroll position, by going back. After hopping case to case with the
         arrows, or arriving from outside, back would land somewhere else, so it goes to the
         last listing page seen here instead, or the grid. */
      const from = document.referrer ? new URL(document.referrer) : null;
      const onSite = from?.origin === location.origin;
      const fromCase = onSite && /^(\/es)?\/work\/[^/]+/.test(from!.pathname);
      const KEY = 'equator:back';
      try { if (onSite && !fromCase) sessionStorage.setItem(KEY, from!.pathname); } catch {}
      const grid = document.querySelector('[data-close]')!.getAttribute('href')!; // the work grid, in this page's language
      const close = () => {
        if (onSite && !fromCase && history.length > 1) return history.back();
        let back: string | null = null;
        try { back = sessionStorage.getItem(KEY); } catch {}
        location.href = back ?? grid;
      };
      document.querySelectorAll<HTMLAnchorElement>('[data-close]').forEach((a) =>
        a.addEventListener('click', (e) => { e.preventDefault(); close(); }),
      );

      /* Full-size view. On a phone held upright the shot fills the height and pans
         sideways, which is the only way a landscape screenshot gets bigger there. */
      const zoom = document.getElementById('zoom') as HTMLDialogElement;
      const zoomImg = zoom.querySelector<HTMLImageElement>('.zoom__img')!;
      const pan = zoom.querySelector<HTMLElement>('.zoom__pan')!;
      let opener: HTMLElement | null = null;
      document.querySelectorAll<HTMLButtonElement>('.stage__zoom').forEach((button) =>
        button.addEventListener('click', () => {
          const shot = button.querySelector('img')!;
          opener = button;
          // Open instantly on the copy already on screen, then swap in the full-width build
          // (the img's src; srcset only picked a size for the stage) once it has decoded.
          zoomImg.src = shot.currentSrc || shot.src;
          zoomImg.alt = shot.alt;
          zoom.showModal();
          const centre = () => { pan.scrollLeft = (pan.scrollWidth - pan.clientWidth) / 2; };
          if (zoomImg.complete) centre(); else zoomImg.addEventListener('load', centre, { once: true });
          const full = new Image();
          full.src = shot.getAttribute('src')!;
          full.decode().then(() => { if (zoom.open && opener === button) zoomImg.src = full.src; }, () => {});
        }),
      );
      zoom.querySelector('.zoom__close')!.addEventListener('click', () => zoom.close());
      zoom.addEventListener('click', (e) => { if (e.target === zoom || e.target === pan) zoom.close(); });
      zoom.addEventListener('close', () => opener?.focus());

      document.addEventListener('keydown', (e) => {
        if (zoom.open) {
          // Arrows pan the shot. Escape is the dialog's own, but closing here as well keeps
          // it working in embedded browsers whose dialogs ignore the key.
          if (e.key === 'Escape') zoom.close();
          return;
        }
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') (document.querySelector('.stage__nav--prev') as HTMLAnchorElement).click();
        if (e.key === 'ArrowRight') (document.querySelector('.stage__nav--next') as HTMLAnchorElement).click();
      });
    </script>
  </body>
</html>

<style>
  .detail { display: grid; grid-template-columns: 1fr 440px; height: 100dvh; overflow: hidden; }
  .stage { position: relative; background: var(--stage); min-width: 0; overflow: hidden; }
  .stage__scroll { position: absolute; inset: 0; overflow-y: auto; display: flex; flex-direction: column; gap: 16px; padding: 40px 48px 20px; scrollbar-width: thin; scrollbar-color: color-mix(in srgb, var(--fg) 20%, transparent) transparent; }
  .stage__close, .stage__nav {
    position: absolute; top: 22px; left: 22px; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center;
    background: color-mix(in srgb, var(--fg) 8%, transparent); color: var(--fg); z-index: 2; transition: background .15s;
  }
  .stage__close:hover, .stage__nav:hover { background: color-mix(in srgb, var(--fg) 16%, transparent); }
  /* Desktop closes from the panel's button; a second one here sat on the first shot's corner.
     Phones hide the panel's and pin this one to the top of the page instead. */
  .stage__close { display: none; }
  .stage__nav { top: 50%; transform: translateY(-50%); opacity: 0; }
  /* Hover shows them to a mouse; focus-within shows them to a keyboard that tabbed in. */
  .stage:hover .stage__nav, .stage:focus-within .stage__nav { opacity: 1; }
  .stage__nav--next { left: auto; right: 22px; }
  .stage__media { position: relative; flex: 1; margin: 0; border-radius: 12px; overflow: hidden; min-height: 0; }
  .stage__media--shot { flex: none; }
  /* No gallery: the cover keeps the render's own frame instead of stretching to fill
     the column, so a brand plate reads at the same proportions as a screenshot. */
  .stage__media--cover { flex: none; aspect-ratio: 4 / 3; margin-block: auto; }
  /* Renders are transparent, so each shot gets a plain plate. Both light and dark
     screenshots need to separate from the stage, and a pattern here fights the work. */
  .stage__media--shot { background: #fff; }
  .stage__media--shot img { display: block; width: 100%; height: auto; }
  .stage__zoom { display: block; width: 100%; cursor: zoom-in; }
  .stage__zoom:focus-visible { outline: 2px solid var(--sun); outline-offset: -2px; border-radius: 12px; }
  .stage__play { position: absolute; inset: 0; margin: auto; width: 72px; height: 72px; border-radius: 50%; background: rgba(255,255,255,.14); backdrop-filter: blur(8px); display: grid; place-items: center; color: #fff; }
  .stage__play :global(.fill) { fill: currentColor; margin-left: 4px; }
  .stage__bar { display: flex; justify-content: center; gap: 28px; align-items: center; padding-top: 4px; color: #fff; font-size: 15px; flex: none; }
  .stage__bar span { display: inline-flex; align-items: center; gap: 8px; }
  .stage__bar .muted { color: #bdbdbd; }

  .panel { padding: 28px 28px 24px; overflow-y: auto; display: flex; flex-direction: column; gap: 18px; border-left: 1px solid var(--line); }
  /* Two halves so a phone can lift the intro above the screenshots. On desktop they
     stack in the one scrolling column with the same spacing as before. */
  .panel__intro, .panel__rest { display: flex; flex-direction: column; gap: 18px; }
  .panel__rest { flex: 1; }
  .panel__head { display: flex; align-items: center; justify-content: space-between; }
  .panel__title { font-family: var(--font-display); font-size: 34px; font-weight: 400; letter-spacing: 0; line-height: 1.05; }
  .panel__desc { font-size: 15px; line-height: 1.6; color: var(--muted); }
  .panel__site { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 500; align-self: flex-start; border-bottom: 1px solid var(--line); }
  .panel__site:hover { border-color: var(--fg); }
  /* Facts, not engagement: what it is, who it was for, whether it is live. */
  .facts { margin: 4px 0 0; display: grid; gap: 0; border-top: 1px solid var(--line); }
  .facts__row { display: grid; grid-template-columns: 92px 1fr; gap: 12px; padding: 11px 0; border-bottom: 1px solid var(--line); }
  .facts dt { font-size: 12px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--faint); padding-top: 2px; }
  .facts dd { margin: 0; font-size: 14px; line-height: 1.5; }
  .panel__block { display: flex; flex-direction: column; gap: 12px; }
  .shipped { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .shipped li { position: relative; padding-left: 20px; font-size: 14px; line-height: 1.55; color: var(--muted); }
  .shipped li::before { content: ""; position: absolute; left: 0; top: 8px; width: 9px; height: 2px; background: var(--sun); }
  .panel__tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .panel__quote { margin: 0; padding: 20px; border-radius: 14px; background: var(--pill); display: flex; flex-direction: column; gap: 10px; }
  .panel__quote blockquote { margin: 0; font-family: var(--font-display); font-size: 20px; line-height: 1.35; }
  .panel__quote figcaption { font-size: 13px; }
  .panel__foot { margin-top: auto; padding-top: 16px; display: flex; flex-wrap: wrap; gap: 10px; }

  .zoom {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0;
    border: 0; background: rgba(0,0,0,.94); color: #fff;
  }
  .zoom::backdrop { background: rgba(0,0,0,.5); }
  .detail:has(.zoom[open]) { overflow: hidden; }
  /* The shot fills the height. Wide windows fit it whole; an upright phone scrolls across it. */
  .zoom__pan { display: flex; width: 100%; height: 100%; padding: 16px; overflow: auto; outline: none; }
  .zoom__img { margin: auto; height: 100%; width: auto; max-width: none; border-radius: 12px; background: #fff; }
  .zoom__close {
    position: absolute; top: 22px; right: 22px; z-index: 1; width: 44px; height: 44px; border-radius: 50%;
    display: grid; place-items: center; background: rgba(0,0,0,.55); color: #fff; transition: background .15s;
  }
  .zoom__close:hover { background: rgba(0,0,0,.8); }

  @media (max-width: 960px) {
    /* A phone reads top to bottom, so what the project is comes before the screenshots.
       The panel dissolves into the page and its intro is ordered above the stage. The
       stage stops being a positioning box, so its buttons pin to the top of the page. */
    .detail { grid-template-columns: 1fr; height: auto; overflow: auto; position: relative; }
    .stage { overflow: visible; position: static; }
    .stage__scroll { position: static; overflow: visible; padding: 8px 16px 16px; }
    .stage__media { aspect-ratio: 4 / 3; flex: none; }
    .stage__media--shot { aspect-ratio: auto; }
    .stage__close { display: grid; }
    .stage__nav { opacity: 1; top: 22px; transform: none; left: auto; right: 74px; }
    .stage__nav--next { right: 22px; }
    .panel { display: contents; }
    .panel__intro { order: -1; padding: 80px 28px 12px; }
    .panel__rest { padding: 28px 28px 24px; border-top: 1px solid var(--line); }
    .panel__head .iconbtn { display: none; }
  }
</style>
