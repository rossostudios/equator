---
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import CopyEmail from '../../components/CopyEmail.astro';
import Icon from '../../components/Icon.astro';
import { ArrowRight02Icon } from '../../data/icons';
import { projects } from '../../data/work';
import { type Lang, langPaths, href } from '../../i18n';
import { ui } from '../../i18n/ui';
/* No tabs, sort or filters: four projects scan faster than a panel that sorts them.
   They earn a filter back once the grid runs past a screen. */

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const u = ui[lang];
/* This grid stays at two columns on wide screens, so its covers draw bigger than the default. */
const WORK_SIZES = '(max-width: 680px) calc(100vw - 32px), (max-width: 1100px) calc(50vw - 60px), (max-width: 1240px) calc(50vw - 62px), 558px';

const en = {
  title: 'Work',
  eyebrow: 'Work',
  description: 'Products Christopher Rosso designed and built end to end: Plazuela, a live marketplace; Petzone, the point of sale a pet store in Itagüí, Colombia runs on; Purrsuit, a game for iPhone; and this site, a brick town built in three.js.',
  heading: 'Brand, product and software, end to end.',
  lede: 'I designed and built every one of these myself. Two are live and in use by real businesses.',
  closeHeading: 'Work with me',
  closeEyebrow: 'Next',
  close: "Tell me what you're building and I'll tell you what it costs and when it ships.",
};
const es: typeof en = {
  title: 'Trabajo',
  eyebrow: 'Trabajo',
  description: 'Productos que Christopher Rosso diseñó y desarrolló de principio a fin: Plazuela, un marketplace en vivo; Petzone, el punto de venta de una tienda de mascotas en Itagüí, Colombia; Purrsuit, un juego para iPhone; y este sitio, un pueblo de piezas hecho en three.js.',
  heading: 'Marca, producto y software, de principio a fin.',
  lede: 'Diseñé y desarrollé cada uno de estos yo mismo. Dos están en vivo y los usan negocios reales.',
  closeHeading: 'Trabajemos juntos',
  closeEyebrow: 'Siguiente',
  close: 'Cuéntame qué estás construyendo y te digo cuánto cuesta y cuándo sale.',
};
const t = { en, es }[lang];

/* The work as a list answer engines can read: each case study, in order. */
const site = Astro.site ?? new URL('https://chrisrosso.dev');
const graph = [{
  '@type': 'ItemList',
  '@id': `${new URL(href(lang, '/work'), site).href}#projects`,
  itemListElement: projects.map((p, i) => ({
    '@type': 'ListItem', position: i + 1, name: p.title, url: new URL(href(lang, `/work/${p.slug}`), site).href,
  })),
}];
---
<Base title={t.title} description={t.description} lang={lang} graph={graph}>
  <section class="workhead">
    <p class="eyebrow hero__eyebrow">{t.eyebrow}</p>
    <h1 class="display">{t.heading}</h1>
    <p class="lede">{t.lede}</p>
  </section>

  <div class="grid grid--work">
    {projects.map((p) => <WorkCard project={p} lang={lang} sizes={WORK_SIZES} />)}
  </div>

  <!-- Someone who has just looked through the work is the likeliest to write. Give them the door. -->
  <section class="section close sheet" data-reveal>
    <div class="section__head"><h2 class="h2">{t.closeHeading}</h2><span class="eyebrow">{t.closeEyebrow}</span></div>
    <p class="lede">{t.close}</p>
    <p class="work__cta">
      <a class="btn" href={href(lang, '/build')}>{u.cta.start} <Icon icon={ArrowRight02Icon} size={16} strokeWidth={2} /></a>
      <CopyEmail class="btn btn--ghost" lang={lang} />
    </p>
  </section>
</Base>

<style>
  .workhead { max-width: 820px; margin-bottom: 48px; display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .workhead .display { font-size: clamp(38px, 4.8vw, 64px); }
  .close { padding: clamp(24px, 4vw, 40px); }
  /* Four projects: two by two on a wide screen, rather than three and one left on its own. */
  @media (min-width: 1101px) { .grid--work { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .work__cta { margin-top: 22px; display: flex; flex-wrap: wrap; gap: 12px; }
</style>
