---
import '../../styles/booklet.css';
import Meta from '../../components/Meta.astro';
import Bar from '../../components/Bar.astro';
import Footer from '../../components/Footer.astro';
import CopyEmail from '../../components/CopyEmail.astro';
import { schema } from '../../data/schema';
import { parts as partList, SWATCH_PARTS } from '../../data/parts';
import { C, SWATCHES } from '../../scripts/brick-colors';
import { type Lang, langPaths, href, otherLang } from '../../i18n';
import { ui, mailto, EMAIL } from '../../i18n/ui';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const h = (path: string) => href(lang, path);
const u = ui[lang];
const site = Astro.site ?? new URL('https://chrisrosso.dev');

/* The home page is a building-instructions booklet. Each step is a section, and as it
   scrolls in, the town behind it builds that step: the street, then one build per project,
   then an empty lot for the reader's product. The words are plain; the booklet is the one
   turn of phrase. Each step's "parts" callout is its list of what got made.
   English and Spanish side by side; a part is [quantity, name, brick colour]. */
type Parts = [number | null, string, string][];
const en = {
  title: 'Websites, apps and brands for founders and small businesses',
  description: 'Christopher Rosso designs and builds websites, online stores and custom software for founders and small businesses, from the first sketch to launch. Live work at plazuela.app and petzone-coral.vercel.app. English and Spanish.',
  parts: 'Parts',
  get: 'What you get',
  scroll: 'Scroll to build',
  step: 'Step',
  steps: 'Steps',
  caseStudy: 'Case study',
  lotSign: 'YOUR PRODUCT\nGOES HERE',
  intro: {
    eyebrow: 'Christopher Rosso · Building instructions',
    heading: 'Your product, designed and built by one person.',
    body: "I'm Christopher. I design and build websites, online stores and custom software for founders and small businesses, from the first sketch to launch.",
    parts: [[1, 'Brand identity', C.red], [1, 'Product design', C.blue], [1, 'Website', C.yellow], [1, 'Online store', C.green], [1, 'Software', C.orange]] as Parts,
  },
  plazuela: {
    tag: 'Live',
    body: "A business directory for Colombia, drawn as a town you can walk through. Every building is a real business: open the door and you're talking to the owner.",
    parts: [[1, 'Name', C.forest], [1, 'Brand', C.clay], [1, 'Product design', C.azure], [1, 'Website', C.yellow], [1, 'Software', C.lgray]] as Parts,
    open: 'Open plazuela.app',
  },
  petzone: {
    tag: 'Live',
    body: "The till and back office running a pet store in Itagüí, Colombia: fast checkout at the counter, then orders, stock, purchasing, discounts and reports behind it. That's Dasha by the door, the store's mascot.",
    parts: [[1, 'Point of sale', C.orange], [1, 'Back office', C.lgray], [17, 'Video guides', C.dazure], [1, 'Dasha, in 3D', C.lorange]] as Parts,
    open: 'Open Petzone',
  },
  purrsuit: {
    tag: 'In TestFlight',
    body: 'An iPhone game where a crew of cats raids a fish market. Every level ends in a boss fight, and an endless mode follows the fish to the bottom of the sea. The cat in the hoodie is Jinx, its hero.',
    parts: [[1, 'Game design', C.navy], [30, 'Levels', C.azure], [1, 'Jinx, in 3D', C.purple], [1, 'Unity build', C.black]] as Parts,
  },
  lot: {
    heading: 'This lot is for your product.',
    body: "Tell me what you're building and I'll tell you what it costs and when it ships.",
    get: [
      [null, 'A link you can open in week one, before the first page is finished.', C.red],
      [null, 'Code, domain, design files and font licenses, all in your name.', C.yellow],
      [null, 'Fixes after launch, without a new invoice for each one.', C.blue],
      [null, 'Replies within the hour, in English or Spanish.', C.green],
    ] as Parts,
    price: ['Small tasks from ', '$50 an hour', '. Bigger projects get a fixed quote within a day of our first call.'],
    play: 'While you think it over, tap the lot to stack bricks on it. Each colour is a part of a product.',
    from: 'Someone built this lot for you. Add to it, or clear it and start your own.',
    colors: ['Red', 'Yellow', 'Blue', 'Green', 'White', 'Orange'],
    justBrick: 'just a brick',
    colorLabel: 'Brick color',
    add: 'Add a brick',
    clear: 'Clear the lot',
    one: '1 brick on the lot',
    many: '{n} bricks on the lot',
    brief: 'Turn it into a brief',
    share: 'Share this lot',
    copied: 'Link copied. It opens this lot with your bricks on it.',
    where: 'Based in Savannah, Georgia · traveling South America for now · US Eastern time',
  },
};
const es: typeof en = {
  title: 'Sitios web, apps y marcas para fundadores y pequeñas empresas',
  description: 'Christopher Rosso diseña y desarrolla sitios web, tiendas en línea y software a la medida para fundadores y pequeñas empresas, desde el primer boceto hasta el lanzamiento. Trabajo en vivo en plazuela.app y petzone-coral.vercel.app. En español e inglés.',
  parts: 'Piezas',
  get: 'Lo que recibes',
  scroll: 'Baja para armar',
  step: 'Paso',
  steps: 'Pasos',
  caseStudy: 'Caso de estudio',
  lotSign: 'TU PRODUCTO\nVA AQUÍ',
  intro: {
    eyebrow: 'Christopher Rosso · Instrucciones de armado',
    heading: 'Tu producto, diseñado y construido por una sola persona.',
    body: 'Soy Christopher. Diseño y desarrollo sitios web, tiendas en línea y software a la medida para fundadores y pequeñas empresas, desde el primer boceto hasta el lanzamiento.',
    parts: [[1, 'Identidad de marca', C.red], [1, 'Diseño de producto', C.blue], [1, 'Sitio web', C.yellow], [1, 'Tienda en línea', C.green], [1, 'Software', C.orange]],
  },
  plazuela: {
    tag: 'En vivo',
    body: 'Un directorio de negocios en Colombia, dibujado como un pueblo que puedes recorrer. Cada edificio es un negocio real: abres la puerta y estás hablando con el dueño.',
    parts: [[1, 'Nombre', C.forest], [1, 'Marca', C.clay], [1, 'Diseño de producto', C.azure], [1, 'Sitio web', C.yellow], [1, 'Software', C.lgray]],
    open: 'Abrir plazuela.app',
  },
  petzone: {
    tag: 'En vivo',
    body: 'La caja y el back office con los que funciona una tienda de mascotas en Itagüí: cobro rápido en el mostrador y, detrás, pedidos, inventario, compras, descuentos y reportes. La de la puerta es Dasha, la mascota de la tienda.',
    parts: [[1, 'Punto de venta', C.orange], [1, 'Back office', C.lgray], [17, 'Guías en video', C.dazure], [1, 'Dasha, en 3D', C.lorange]],
    open: 'Abrir Petzone',
  },
  purrsuit: {
    tag: 'En TestFlight',
    body: 'Un juego para iPhone en el que un grupo de gatos asalta un mercado de pescado. Cada nivel termina con un jefe, y un modo infinito sigue al pescado hasta el fondo del mar. El gato del buzo morado es Jinx, el protagonista.',
    parts: [[1, 'Diseño de juego', C.navy], [30, 'Niveles', C.azure], [1, 'Jinx, en 3D', C.purple], [1, 'Desarrollo en Unity', C.black]],
  },
  lot: {
    heading: 'Este lote es para tu producto.',
    body: 'Cuéntame qué estás construyendo y te digo cuánto cuesta y cuándo sale.',
    get: [
      [null, 'Un enlace que puedes abrir en la primera semana, antes de que esté lista la primera página.', C.red],
      [null, 'Código, dominio, archivos de diseño y licencias de fuentes, todo a tu nombre.', C.yellow],
      [null, 'Arreglos después del lanzamiento, sin una factura nueva por cada uno.', C.blue],
      [null, 'Respuesta en menos de una hora, en español o inglés.', C.green],
    ],
    price: ['Tareas pequeñas desde ', 'USD 50 la hora', '. Para proyectos más grandes, te envío una cotización fija al día siguiente de nuestra primera llamada.'],
    play: 'Mientras lo piensas, toca el lote para apilar piezas. Cada color es una parte de un producto.',
    from: 'Alguien armó este lote para ti. Agrégale piezas, o límpialo y arma el tuyo.',
    colors: ['Rojo', 'Amarillo', 'Azul', 'Verde', 'Blanco', 'Naranja'],
    justBrick: 'solo una pieza',
    colorLabel: 'Color de la pieza',
    add: 'Poner una pieza',
    clear: 'Limpiar el lote',
    one: '1 pieza en el lote',
    many: '{n} piezas en el lote',
    brief: 'Convertirlo en proyecto',
    share: 'Compartir este lote',
    copied: 'Enlace copiado. Abre este lote con tus piezas.',
    where: 'Vivo en Savannah, Georgia · por ahora viajando por Sudamérica · horario del este de EE. UU.',
  },
};
const t = { en, es }[lang];

const projects = [
  { slug: 'plazuela', title: 'Plazuela', url: 'https://www.plazuela.app/', ...t.plazuela },
  { slug: 'petzone', title: 'Petzone', url: 'https://petzone-coral.vercel.app', ...t.petzone },
  { slug: 'purrsuit', title: 'Purrsuit', url: undefined, open: undefined, ...t.purrsuit },
];
const count = projects.length + 2;

/* Each swatch's colour stands for a part on the lot, so a pile of bricks can become a brief. */
const lower = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);
const swatchName = (i: number) => {
  const part = partList.find((p) => p.id === SWATCH_PARTS[i]);
  return `${t.lot.colors[i]}: ${part ? lower(part[lang][0]) : t.lot.justBrick}`;
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Meta title={`Christopher Rosso — ${t.title}`} description={t.description} lang={lang} themeColor="#f7f5f1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(schema(site))} />
  </head>
  <body>
    <Bar lang={lang} overlay />

    <!-- The town. Decoration for sighted readers: everything it shows is also in the text. -->
    <div class="stage" id="stage" aria-hidden="true" data-lot={t.lotSign}>
      <canvas></canvas>
    </div>

    <nav class="pager" data-pager aria-label={t.steps}>
      {Array.from({ length: count }, (_, i) => <a href={`#step-${i + 1}`} aria-label={`${t.step} ${i + 1}`}>{i + 1}</a>)}
    </nav>

    <main class="steps" id="main" tabindex="-1">
      <section class="step step--intro" id="step-1" data-step="0">
        <div class="card">
          <span class="num" aria-hidden="true">1</span>
          <p class="eyebrow">{t.intro.eyebrow}</p>
          <h1 class="title title--hero">{t.intro.heading}</h1>
          <p class="body">{t.intro.body}</p>
          <div class="callout">
            <p class="callout__title">{t.parts}</p>
            <ul class="parts">
              {t.intro.parts.map(([n, name, c]) => <li><span class="brick" style={`--c:${c}`}></span>{n !== null && <span class="qty">{n}×</span>}{name}</li>)}
            </ul>
          </div>
          <div class="actions">
            <a class="btn" href={h('/build')}>{u.cta.build}</a>
          </div>
        </div>
        <a class="hint" href="#step-2">{t.scroll} <span aria-hidden="true">↓</span></a>
      </section>

      {projects.map((p, i) => (
        <section class="step" id={`step-${i + 2}`} data-step={i + 1}>
          <div class="card">
            <div class="card__top">
              <span class="num" aria-hidden="true">{i + 2}</span>
              <span class:list={['tag', { 'tag--live': p.url }]}>{p.tag}</span>
            </div>
            <h2 class="title">{p.title}</h2>
            <p class="body">{p.body}</p>
            <div class="callout">
              <p class="callout__title">{t.parts}</p>
              <ul class="parts">
                {p.parts.map(([n, name, c]) => <li><span class="brick" style={`--c:${c}`}></span>{n !== null && <span class="qty">{n}×</span>}{name}</li>)}
              </ul>
            </div>
            <div class="actions">
              {p.url && <a class="btn btn--ghost" href={p.url} target="_blank" rel="noopener noreferrer">{p.open} <span aria-hidden="true">↗</span><span class="sr-only"> {u.newTab}</span></a>}
              <a class="link" href={h(`/work/${p.slug}`)}>{t.caseStudy} <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </section>
      ))}

      <section class="step step--lot" id={`step-${count}`} data-step={count - 1}>
        <div class="card">
          <span class="num" aria-hidden="true">{count}</span>
          <h2 class="title">{t.lot.heading}</h2>
          <p class="body">{t.lot.body}</p>
          <div class="callout">
            <p class="callout__title">{t.get}</p>
            <ul class="parts parts--wide">
              {t.lot.get.map(([, line, c]) => <li><span class="brick" style={`--c:${c}`}></span>{line}</li>)}
            </ul>
          </div>
          <p class="price">{t.lot.price[0]}<strong>{t.lot.price[1]}</strong>{t.lot.price[2]}</p>
          <div class="actions">
            <a class="btn" href={h('/build')}>{u.cta.build}</a>
            <span class="email"><a class="link" href={mailto()}>{EMAIL}</a> <CopyEmail class="copy" lang={lang} short /></span>
          </div>
          <div class="play">
            <p class="play__from" data-lot-from hidden>{t.lot.from}</p>
            <p class="play__lede">{t.lot.play}</p>
            <div class="play__row">
              <div class="swatches" role="group" aria-label={t.lot.colorLabel}>
                {SWATCHES.map((c, i) => <button type="button" class="swatch" data-swatch={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={swatchName(i)} style={`--c:${c}`}></button>)}
              </div>
              <button type="button" class="chip" data-add>{t.lot.add}</button>
              <button type="button" class="chip chip--quiet" data-clear>{t.lot.clear}</button>
            </div>
            <p class="play__legend" data-swatch-part aria-hidden="true">{swatchName(0)}</p>
            <p class="play__count" data-count data-one={t.lot.one} data-many={t.lot.many}></p>
            <!-- What the lot can become: a link to send, or the start of a brief (bricks.ts). -->
            <div class="play__row play__out">
              <a class="chip chip--go" href={h('/build')} data-brief-lot data-build={h('/build')} hidden>{t.lot.brief} <span aria-hidden="true">→</span></a>
              <button type="button" class="chip" data-share-lot hidden>{t.lot.share}</button>
            </div>
            <p class="play__msg" data-lot-msg data-copied={t.lot.copied} aria-live="polite"></p>
          </div>
          <p class="where">{t.lot.where}</p>
        </div>
      </section>
    </main>
    <Footer lang={lang} />

    <script>
      import '../../scripts/bricks';
    </script>
  </body>
</html>
