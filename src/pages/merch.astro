---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Blocks from '../components/Blocks.astro';
import { ArrowRight02Icon } from '../data/icons';
import { merch } from '../data/merch';
---
<Base title="Merch">
  <section class="merch">
    <div class="merch__head">
      <h1 class="display">Things for the studio, and yours.</h1>
      <span class="badge">Work in progress</span>
    </div>
    <p class="lede">
      {merch.length
        ? 'A short run of pieces that feel like the work.'
        : 'A short run of pieces that feel like the work. Nothing exists yet, so there is nothing here to show.'}
    </p>
  </section>

  {merch.length ? (
    <div class="grid">
      {merch.map((item) => (
        <article class="item">
          <p class="item__name">{item.name}</p>
          <p class="muted item__note">{item.note}</p>
          {item.price && <p class="item__price">{item.price}</p>}
          {item.url && <a class="link" href={item.url} target="_blank" rel="noopener noreferrer">Buy it</a>}
        </article>
      ))}
    </div>
  ) : (
    <section class="empty">
      <span class="empty__blocks"><Blocks seed={47} cols={18} rows={2} palette={['#8898ff', '#ff9ec4', '#ffb020', '#ff6b1a']} stretch /></span>
      <div class="empty__body">
        <h2 class="h2">Not made yet.</h2>
        <p class="muted">
          The plan is a studio pass tee, a cap, and a print of the horizon line. None of it is
          printed, priced or orderable, so there is nothing to put on this page.
        </p>
        <p class="muted">Leave your email and you will hear first when there is.</p>
        <a class="btn" href="mailto:chrisrossonyc@gmail.com?subject=Merch%20waitlist">Get on the list <Icon icon={ArrowRight02Icon} size={16} strokeWidth={2} /></a>
      </div>
    </section>
  )}
</Base>

<style>
  .merch { max-width: 720px; margin-bottom: 56px; display: flex; flex-direction: column; gap: 20px; align-items: flex-start; }
  .merch__head { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .item { display: flex; flex-direction: column; gap: 6px; align-items: flex-start; }
  .item__name { font-size: 17px; font-weight: 500; }
  .item__note { font-size: 14px; }
  .item__price { font-size: 14px; font-weight: 500; }

  /* Empty state: the house pattern, what the plan is, and one way to hear about it. */
  .empty {
    max-width: 640px; border: 1px solid var(--line); border-radius: var(--radius);
    overflow: hidden; background: var(--surface);
  }
  .empty__blocks { display: block; height: 12px; }
  .empty__blocks :global(svg) { width: 100%; height: 100%; display: block; }
  .empty__body { padding: 32px; display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
  .empty__body p { max-width: 52ch; line-height: 1.6; }
  .empty__body .btn { margin-top: 8px; }
  @media (max-width: 760px) { .empty__body { padding: 24px; } }
</style>
