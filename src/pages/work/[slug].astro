---
import '../../styles/global.css';
import Icon from '../../components/Icon.astro';
import Cover from '../../components/Cover.astro';
import { projects } from '../../data/work';
import { testimonials } from '../../data/testimonials';
import { Cancel01Icon, ArrowLeft02Icon, ArrowRight02Icon, PlayIcon, LinkSquare02Icon } from '../../data/icons';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
const { project: p } = Astro.props;
const idx = projects.findIndex((x) => x.slug === p.slug);
const prev = projects[(idx - 1 + projects.length) % projects.length];
const next = projects[(idx + 1) % projects.length];
const quote = testimonials.find((t) => t.company === p.client);
const facts: [string, string][] = [
  ['Client', p.client],
  ['Scope', p.scope ?? p.category],
  ['Year', String(p.year)],
  ['Status', p.status === 'wip' ? 'In progress' : 'Live'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{p.title} — Equator</title>
    <meta name="description" content={p.description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="detail">
    <section class="stage">
      <a class="stage__close" href="/work" aria-label="Back to work" data-tip="Close"><Icon icon={Cancel01Icon} size={22} /></a>
      <a class="stage__nav stage__nav--prev" href={`/work/${prev.slug}`} aria-label={`Previous: ${prev.title}`}><Icon icon={ArrowLeft02Icon} size={22} /></a>
      <a class="stage__nav stage__nav--next" href={`/work/${next.slug}`} aria-label={`Next: ${next.title}`}><Icon icon={ArrowRight02Icon} size={22} /></a>
      <div class="stage__scroll">
        {p.gallery ? (
          p.gallery.map((shot, i) => (
            <figure
              class="stage__media stage__media--shot"
              style={i === 0 ? `view-transition-name: cover-${p.slug}` : undefined}
              data-reveal={i === 0 ? undefined : true}
            >
              <img src={shot.src} alt={shot.alt} width={shot.w} height={shot.h} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
            </figure>
          ))
        ) : (
          <figure class="stage__media stage__media--cover" style={`view-transition-name: cover-${p.slug}`}>
            <Cover project={p} eager />
            {p.video && <span class="stage__play"><Icon icon={PlayIcon} size={28} strokeWidth={0} class="fill" /></span>}
          </figure>
        )}
      </div>
    </section>

    <aside class="panel">
      <header class="panel__head">
        <p class="eyebrow">Case study</p>
        <a class="iconbtn" href="/work" aria-label="Back to work"><Icon icon={Cancel01Icon} size={18} /></a>
      </header>

      <h1 class="panel__title">{p.title}</h1>
      <p class="panel__desc">{p.description}</p>
      {p.url && <a class="panel__site" href={p.url} target="_blank" rel="noopener noreferrer"><Icon icon={LinkSquare02Icon} size={16} /> {p.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a>}

      <dl class="facts">
        {facts.map(([label, value]) => (
          <div class="facts__row"><dt>{label}</dt><dd>{value}</dd></div>
        ))}
      </dl>

      {p.highlights && (
        <section class="panel__block">
          <p class="eyebrow">What shipped</p>
          <ul class="shipped">{p.highlights.map((h) => <li>{h}</li>)}</ul>
        </section>
      )}

      <section class="panel__block">
        <p class="eyebrow">Tagged</p>
        <div class="panel__tags">{p.tags.map((t) => <a class="chip chip--outline" href={`/work?tag=${encodeURIComponent(t)}`}>{t}</a>)}</div>
      </section>

      {quote && (
        <figure class="panel__quote">
          <blockquote>{quote.quote}</blockquote>
          <figcaption class="muted">{quote.name} &middot; {quote.role}, {quote.company}</figcaption>
        </figure>
      )}

      <footer class="panel__foot">
        <a class="btn" href={`mailto:chrisrossonyc@gmail.com?subject=${encodeURIComponent('Project like ' + p.title)}`}>Start something similar <Icon icon={ArrowRight02Icon} size={16} strokeWidth={2} /></a>
      </footer>
    </aside>

    <script>
      const shots = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
        shots.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0 },
        );
        shots.forEach((el) => io.observe(el));
        setTimeout(() => {
          if (!document.querySelector('[data-reveal].is-in')) shots.forEach((el) => el.classList.add('is-in'));
        }, 3000);
      }

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') location.href = '/work';
        if (e.key === 'ArrowLeft') (document.querySelector('.stage__nav--prev') as HTMLAnchorElement).click();
        if (e.key === 'ArrowRight') (document.querySelector('.stage__nav--next') as HTMLAnchorElement).click();
      });
    </script>
  </body>
</html>

<style>
  .detail { display: grid; grid-template-columns: 1fr 440px; height: 100dvh; overflow: hidden; }
  .stage { position: relative; background: #000; min-width: 0; overflow: hidden; }
  .stage__scroll { position: absolute; inset: 0; overflow-y: auto; display: flex; flex-direction: column; gap: 16px; padding: 40px 48px 20px; scrollbar-width: thin; scrollbar-color: rgba(255,255,255,.2) transparent; }
  .stage__close, .stage__nav {
    position: absolute; top: 22px; left: 22px; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center;
    background: rgba(255,255,255,.08); color: #fff; z-index: 2; transition: background .15s;
  }
  .stage__close:hover, .stage__nav:hover { background: rgba(255,255,255,.18); }
  .stage__close[data-tip]::after { background: #fff; color: #111; }
  .stage__close[data-tip]::before { border-right-color: #fff; }
  .stage__nav { top: 50%; transform: translateY(-50%); opacity: 0; }
  .stage:hover .stage__nav { opacity: 1; }
  .stage__nav--next { left: auto; right: 22px; }
  .stage__media { position: relative; flex: 1; margin: 0; border-radius: 12px; overflow: hidden; min-height: 0; }
  .stage__media--shot { flex: none; }
  /* No gallery: the cover keeps the render's own frame instead of stretching to fill
     the column, so a brand plate reads at the same proportions as a screenshot. */
  .stage__media--cover { flex: none; aspect-ratio: 4 / 3; margin-block: auto; }
  /* Renders are transparent, so each shot gets a plain plate. Both light and dark
     screenshots need to separate from the stage, and a pattern here fights the work. */
  .stage__media--shot { background: #fff; }
  .stage__media--shot img { display: block; width: 100%; height: auto; }
  .stage__play { position: absolute; inset: 0; margin: auto; width: 72px; height: 72px; border-radius: 50%; background: rgba(255,255,255,.14); backdrop-filter: blur(8px); display: grid; place-items: center; color: #fff; }
  .stage__play :global(.fill) { fill: currentColor; margin-left: 4px; }
  .stage__bar { display: flex; justify-content: center; gap: 28px; align-items: center; padding-top: 4px; color: #fff; font-size: 15px; flex: none; }
  .stage__bar span { display: inline-flex; align-items: center; gap: 8px; }
  .stage__bar .muted { color: #bdbdbd; }

  .panel { padding: 28px 28px 24px; overflow-y: auto; display: flex; flex-direction: column; gap: 18px; border-left: 1px solid var(--line); }
  .panel__head { display: flex; align-items: center; justify-content: space-between; }
  .panel__title { font-family: var(--font-display); font-size: 34px; font-weight: 400; letter-spacing: 0; line-height: 1.05; }
  .panel__desc { font-size: 15px; line-height: 1.6; color: var(--muted); }
  .panel__site { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 500; align-self: flex-start; border-bottom: 1px solid var(--line); }
  .panel__site:hover { border-color: var(--fg); }
  /* Facts, not engagement: what it is, who it was for, whether it is live. */
  .facts { margin: 4px 0 0; display: grid; gap: 0; border-top: 1px solid var(--line); }
  .facts__row { display: grid; grid-template-columns: 92px 1fr; gap: 12px; padding: 11px 0; border-bottom: 1px solid var(--line); }
  .facts dt { font-size: 12px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--faint); padding-top: 2px; }
  .facts dd { margin: 0; font-size: 14px; line-height: 1.5; }
  .panel__block { display: flex; flex-direction: column; gap: 12px; }
  .shipped { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .shipped li { position: relative; padding-left: 20px; font-size: 14px; line-height: 1.55; color: var(--muted); }
  .shipped li::before { content: ""; position: absolute; left: 0; top: 8px; width: 9px; height: 2px; background: var(--sun); }
  .panel__tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .panel__quote { margin: 0; padding: 20px; border-radius: 14px; background: var(--pill); display: flex; flex-direction: column; gap: 10px; }
  .panel__quote blockquote { margin: 0; font-family: var(--font-display); font-size: 20px; line-height: 1.35; }
  .panel__quote figcaption { font-size: 13px; }
  .panel__foot { margin-top: auto; padding-top: 16px; }

  @media (max-width: 960px) {
    .detail { grid-template-columns: 1fr; height: auto; overflow: auto; }
    .stage { overflow: visible; }
    .stage__scroll { position: static; overflow: visible; padding: 72px 16px 16px; }
    .stage__media { aspect-ratio: 4 / 3; flex: none; }
    .stage__media--shot { aspect-ratio: auto; }
    .stage__nav { opacity: 1; top: 22px; transform: none; left: auto; right: 74px; }
    .stage__nav--next { right: 22px; }
    .panel { border-left: 0; border-top: 1px solid var(--line); }
    .panel__head .iconbtn { display: none; }
  }
</style>
