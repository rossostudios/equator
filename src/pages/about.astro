---
import Base from '../layouts/Base.astro';
import Blocks from '../components/Blocks.astro';
import Tools from '../components/Tools.astro';
import Icon from '../components/Icon.astro';
import CopyEmail from '../components/CopyEmail.astro';
import { ArrowRight02Icon } from '../data/icons';

/* The studio is named after a line. The work has been a slow move toward it. */
const chapters = [
  { era: 'Roots', band: ['#8898ff', '#c3ccff', '#0f332b'], title: 'Family business', body: "I learned the trade on the shop floor, not in a classroom. If it broke, it was mine to fix before dinner. That's a skill that never expired." },
  { era: 'Self-taught', band: ['#ffb020', '#8898ff', '#ff6b1a'], title: 'IT management', body: "Networks, hardware, the people stuck using both. I found out the expensive way that software nobody maintains becomes a second job for everyone." },
  { era: 'Now', band: ['#ff6b1a', '#ffb020', '#ff9ec4'], title: 'Design & software', body: "I design the product and direct the build, AI agents do the heavy typing, and I answer for the result. A few degrees off the equator, in English or Spanish." },
];
---
<Base
  title="About Christopher Rosso"
  description="Christopher Rosso, one person from brief to launch and still reachable after it ships. New Jersey shop floor, then the operations behind small businesses, now design and software from Medellin in English and Spanish."
>
  <section class="intro">
    <p class="eyebrow hero__eyebrow" data-reveal style="--d:0">About</p>
    <h1 class="display" data-reveal style="--d:1">I'm Christopher, and this is the whole <em>studio</em>.</h1>
    <p class="lede" data-reveal style="--d:2">
      One person from brief to launch, and still reachable after it ships. I spent years running the
      operations behind small businesses, and the pattern was always the same: launch day was when the
      problems started. So I build things that survive contact with a real customer base, not just a demo.
    </p>
  </section>

  <section class="section story">
    <div class="section__head" data-reveal><h2 class="h2">How I got here</h2><span class="eyebrow">Background</span></div>
    <p class="lede story__note" data-reveal>Thirty-four degrees of latitude, one job at a time.</p>
    <p class="story__axis" data-reveal><span>40&deg; N &middot; New Jersey</span><span>6&deg; N &middot; Medell&iacute;n</span></p>
    <ol class="story__stops">
      {chapters.map((c, i) => (
        <li class="story__stop" data-reveal style={`--d:${i}`}>
          <span class="story__band"><Blocks seed={i * 53 + 11} cols={16} rows={2} palette={c.band} stretch /></span>
          <div class="story__content">
            <span class="eyebrow">{c.era}</span>
            <h3>{c.title}</h3>
            <p class="muted">{c.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section">
    <div class="section__head" data-reveal><h2 class="h2">Tools I use and love</h2><span class="eyebrow">Stack</span></div>
    <Tools />
  </section>

  <section class="section" data-reveal>
    <div class="section__head"><h2 class="h2">Work with me</h2><span class="eyebrow">Next</span></div>
    <p class="lede about__close">Your project runs like a business I own, because for a few weeks, it is.</p>
    <p class="about__cta">
      <a class="btn" href="mailto:chrisrossonyc@gmail.com?subject=New%20project">Start a project <Icon icon={ArrowRight02Icon} size={16} strokeWidth={2} /></a>
      <CopyEmail class="btn btn--ghost" />
      <a class="btn btn--ghost" href="/work">See the work</a>
    </p>
  </section>
</Base>

<style>
  .intro { max-width: 760px; margin-bottom: 64px; display: flex; flex-direction: column; gap: 20px; align-items: flex-start; }
  .intro .display { font-size: clamp(38px, 4.6vw, 60px); }

  /* Background is three cards, same language as the services grid. */
  .story__note { margin-top: -6px; max-width: 42ch; }
  .story__axis {
    display: flex; justify-content: space-between; gap: 16px; margin-top: 44px;
    font-size: 12px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--faint);
  }
  .story__stops { list-style: none; margin: 18px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  /* Not links, so they hold still on hover. */
  .story__stop {
    display: flex; flex-direction: column; overflow: hidden;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
  }
  /* The band shifts palette card to card: cool in the north, warm at the line. */
  .story__band { display: block; height: 14px; }
  .story__band :global(svg) { width: 100%; height: 100%; display: block; }
  .story__content { padding: 22px; display: flex; flex-direction: column; gap: 10px; }
  .story__stop h3 { font-family: var(--font-display); font-size: 25px; font-weight: 400; letter-spacing: 0; }
  .story__stop p { line-height: 1.6; }

  .about__close { font-family: var(--font-display); font-size: clamp(24px, 2.4vw, 32px); line-height: 1.25; max-width: 30ch; }
  .about__cta { margin-top: 20px; display: flex; flex-wrap: wrap; gap: 12px; }

  @media (max-width: 760px) {
    .story__stops { grid-template-columns: 1fr; }
  }
</style>
