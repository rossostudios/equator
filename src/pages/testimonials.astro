---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Blocks from '../components/Blocks.astro';
import { StarIcon, ArrowRight02Icon } from '../data/icons';
import { testimonials } from '../data/testimonials';
import { projects } from '../data/work';

const shipped = projects.filter((p) => p.status === 'shipped').map((p) => p.title);
---
<Base title="Testimonials">
  <section class="intro">
    <div class="intro__head">
      <h1 class="display">Kind words</h1>
      <span class="badge">Work in progress</span>
    </div>
    <p class="lede">
      {testimonials.length
        ? 'Notes from the people I have built with. Every one of them would pick up the phone if you asked.'
        : 'Notes from the people I have built with. This page fills up as projects wrap, and nothing goes on it that was not actually said.'}
    </p>
  </section>

  {testimonials.length ? (
    <div class="grid quotes">
      {testimonials.map((t) => (
        <figure class="quote">
          <div class="quote__stars">{[0, 1, 2, 3, 4].map(() => <Icon icon={StarIcon} size={14} strokeWidth={0} class="star" />)}</div>
          <blockquote>“{t.quote}”</blockquote>
          <figcaption>
            <span class="quote__avatar" style={`background:hsl(${t.hue} 70% 50%)`}>{t.initials}</span>
            <span><strong>{t.name}</strong><br /><span class="muted">{t.role}, {t.company}</span></span>
          </figcaption>
        </figure>
      ))}
    </div>
  ) : (
    <section class="empty">
      <span class="empty__blocks"><Blocks seed={19} cols={18} rows={2} palette={['#ff6b1a', '#ffb020', '#8898ff', '#ff9ec4']} stretch /></span>
      <div class="empty__body">
        <h2 class="h2">Nothing here yet, on purpose.</h2>
        <p class="muted">
          {shipped.length
            ? `${shipped.join(' and ')} are live and in daily use. I would rather leave this page empty than fill it with words nobody said.`
            : 'I would rather leave this page empty than fill it with words nobody said.'}
        </p>
        <p class="muted">Worked together? Send me a line and it goes here with your name on it.</p>
        <a class="btn" href="mailto:chrisrossonyc@gmail.com?subject=A%20note%20for%20the%20Equator%20site">Send a note <Icon icon={ArrowRight02Icon} size={16} strokeWidth={2} /></a>
      </div>
    </section>
  )}
</Base>

<style>
  .intro { max-width: 720px; margin-bottom: 56px; }
  .intro__head { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .intro .lede { margin-top: 20px; }
  .quotes { gap: 24px; }
  .quote { margin: 0; padding: 28px; border: 1px solid var(--line); border-radius: var(--radius); display: flex; flex-direction: column; gap: 18px; background: rgba(255,255,255,.62); transition: background .15s; }
  .quote:hover { background: var(--surface); }
  .quote__stars { display: flex; gap: 2px; color: var(--fg); }
  .quote__stars :global(.star) { fill: currentColor; }
  blockquote { margin: 0; font-size: 17px; line-height: 1.55; letter-spacing: -.005em; flex: 1; }
  figcaption { display: flex; align-items: center; gap: 12px; font-size: 14px; line-height: 1.35; }
  .quote__avatar { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; color: #fff; font-size: 12px; font-weight: 600; }

  /* Empty state: the house pattern, a plain explanation, and one way to fix it. */
  .empty {
    max-width: 640px; border: 1px solid var(--line); border-radius: var(--radius);
    overflow: hidden; background: var(--surface);
  }
  .empty__blocks { display: block; height: 12px; }
  .empty__blocks :global(svg) { width: 100%; height: 100%; display: block; }
  .empty__body { padding: 32px; display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
  .empty__body p { max-width: 52ch; line-height: 1.6; }
  .empty__body .btn { margin-top: 8px; }
  @media (max-width: 760px) { .empty__body { padding: 24px; } }
</style>
