---
import '../styles/global.css';
import Rail from '../components/Rail.astro';
import TopNav from '../components/TopNav.astro';
import LinksDrawer from '../components/LinksDrawer.astro';
import TipDialog from '../components/TipDialog.astro';
interface Props { title: string; description?: string; filters?: boolean }
const { title, description = 'Equator is a one-person design and development studio by Christopher. Brand identity, product design and websites for founders and small teams, designed and built by the same person.', filters = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Equator</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="shell">
      <Rail />
      <main class="main">
        {filters ? <TopNav filters={filters} /> : <div class="topbar topbar--empty" />}
        <slot />
      </main>
      <LinksDrawer />
      <TipDialog />
    </div>
  </body>
</html>
