---
import '../styles/global.css';
import Bar from '../components/Bar.astro';
import Footer from '../components/Footer.astro';
import Meta from '../components/Meta.astro';
import { schema as schemaFor } from '../data/schema';
import { type Lang, href, otherLang, unprefixed } from '../i18n';

/** The inside pages: the bar on top, the page, the footer. `alternate` is where the language
 *  switch goes; by default the same page in the other language. `graph` is structured data the
 *  page adds to the site's own (a project, its breadcrumbs, a page's questions). */
interface Props { title: string; description?: string; image?: string; imageAlt?: string; noindex?: boolean; lang?: Lang; alternate?: string; graph?: object[] }
const {
  title,
  description = 'Christopher Rosso designs and builds websites, online stores and custom software for founders and small businesses, from the first sketch to launch. Live work at plazuela.app and petzone-coral.vercel.app. English and Spanish.',
  image = '/og.png',
  imageAlt,
  noindex = false,
  lang = 'en',
  alternate = href(otherLang(lang), unprefixed(Astro.url.pathname)),
  graph = [],
} = Astro.props;

const site = Astro.site ?? new URL('https://chrisrosso.dev');
const schema = schemaFor(site, graph);
---
<!doctype html>
<html lang={lang}>
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Meta title={`${title} — Christopher Rosso`} description={description} image={image} imageAlt={imageAlt} noindex={noindex} lang={lang} themeColor="#f7f5f1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <Bar lang={lang} alternate={alternate} />
    <main class="page" id="main" tabindex="-1"><slot /></main>
    <Footer lang={lang} alternate={alternate} />
    <script>
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (still || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0 },
        );
        els.forEach((el) => io.observe(el));
        // Failsafe: a page rendered while hidden gets no observer callbacks, so nothing
        // would ever become visible. If not a single element has reported in, show them all.
        setTimeout(() => {
          if (!document.querySelector('[data-reveal].is-in')) els.forEach((el) => el.classList.add('is-in'));
        }, 3000);
      }
    </script>
  </body>
</html>
