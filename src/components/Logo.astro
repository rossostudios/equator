---
/**
 * My head as a brick: hair on top with its studs, the beard, the smile. The same head the
 * figure in the town wears, drawn flat. Decorative; the name beside it does the talking.
 *
 * It's alive: the eyes follow the pointer and blink now and then (src/scripts/logo.ts), and
 * hovering the link it sits in tips the hair like a hat, the way a brick figure's hair
 * lifts off, to show the stud underneath, with a wink.
 */
interface Props { size?: number; class?: string }
const { size = 30, class: cls } = Astro.props;
const hair = '#2A1D17', skin = '#E0A97E';
---
<svg class:list={['logo', cls]} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <g class="logo__head">
    <!-- The stud on top of the head, normally under the hair. -->
    <rect class="logo__scalp" x="12.5" y="1.6" width="7" height="3.4" rx="1.2" fill="#C98B60" />
    <rect x="3" y="4" width="26" height="27" rx="4" fill={skin} />
    <path d="M3 10h1.7v9.5H3zM27.3 10H29v9.5h-1.7z" fill={hair} />
    <path class="logo__brows" d="M8.2 14.2c1.4-.9 3.4-1.1 5-.5M23.8 14.2c-1.4-.9-3.4-1.1-5-.5" stroke={hair} stroke-width="1.8" stroke-linecap="round" fill="none" />
    <g class="logo__look">
      <g class="logo__eye"><circle cx="10.8" cy="17.3" r="1.4" fill={hair} /></g>
      <g class="logo__eye logo__eye--wink"><circle cx="21.2" cy="17.3" r="1.4" fill={hair} /></g>
    </g>
    <path d="M3 20.8c2.6 1.2 5.3 1.3 7.8.8 1.7-.4 3.5-.5 5.2-.5s3.5.1 5.2.5c2.5.5 5.2.4 7.8-.8V27a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4z" fill={hair} />
    <path class="logo__smile" d="M11.4 23.2c3.1-.6 6.1-.6 9.2 0-.4 2.2-2.2 3.6-4.6 3.6s-4.2-1.4-4.6-3.6z" fill="#fff" />
    <g class="logo__hair">
      <rect x="6.5" y="1" width="7" height="4" rx="1.3" fill={hair} />
      <rect x="18.5" y="1" width="7" height="4" rx="1.3" fill={hair} />
      <path d="M3 8a4 4 0 0 1 4-4h18a4 4 0 0 1 4 4v2.6H3z" fill={hair} />
    </g>
  </g>
</svg>

<style>
  .logo { overflow: visible; flex: none; }
  .logo * { transform-box: fill-box; }
  .logo__head { transform-origin: center bottom; }
  /* The stud on the head only shows once the hair is off it. */
  .logo__scalp { opacity: 0; transition: opacity .15s; }
  .logo__hair { transform-origin: right bottom; transition: transform .45s cubic-bezier(.3, 1.7, .45, 1); }
  .logo__brows { transform-origin: center; transition: transform .3s ease; }
  .logo__smile { transform-origin: center top; transition: transform .3s cubic-bezier(.3, 1.6, .5, 1); }
  /* The eyes follow the pointer (--lx, --ly, set by logo.ts) and blink when .is-blinking. */
  .logo__look { transform: translate(var(--lx, 0px), var(--ly, 0px)); transition: transform .18s ease-out; }
  .logo__eye { transform-origin: center; transition: transform .09s ease; }
  .logo.is-blinking .logo__eye { transform: scaleY(.12); }

  /* Hovering the link (or the logo alone): tip the hair, raise the brows, wink, grin, hop. */
  :global(a:hover) > .logo .logo__hair, :global(a:focus-visible) > .logo .logo__hair, .logo:hover .logo__hair {
    transform: translate(1px, -6.5px) rotate(16deg);
  }
  :global(a:hover) > .logo .logo__scalp, :global(a:focus-visible) > .logo .logo__scalp, .logo:hover .logo__scalp { opacity: 1; }
  :global(a:hover) > .logo .logo__brows, :global(a:focus-visible) > .logo .logo__brows, .logo:hover .logo__brows { transform: translateY(-1.2px); }
  :global(a:hover) > .logo .logo__eye--wink, :global(a:focus-visible) > .logo .logo__eye--wink, .logo:hover .logo__eye--wink { transform: scaleY(.12); }
  :global(a:hover) > .logo .logo__smile, :global(a:focus-visible) > .logo .logo__smile, .logo:hover .logo__smile { transform: scale(1.14, 1.25); }
  :global(a:hover) > .logo .logo__head, :global(a:focus-visible) > .logo .logo__head, .logo:hover .logo__head { animation: logo-hop .5s cubic-bezier(.3, 1.4, .5, 1); }
  @keyframes logo-hop { 30% { transform: translateY(-2.5px) scale(1.04, .97); } 60% { transform: translateY(0) scale(.98, 1.03); } }

  @media (prefers-reduced-motion: reduce) {
    .logo__hair, .logo__brows, .logo__smile, .logo__look, .logo__eye { transition: none; }
    .logo__head { animation: none !important; }
  }
</style>

<script>
  import '../scripts/logo';
</script>
