---
import Glyph from './Glyph.astro';
import type { Lang } from '../i18n';
import { ui } from '../i18n/ui';
/**
 * The day/night switch. It shows the theme you would switch to. Both faces are in the
 * markup and CSS picks one from data-theme, so the label is already right before any
 * script runs; ThemeInit handles the click. The hidden words make the button's name
 * "Switch to Light theme" for a screen reader while the eye reads "Light".
 */
interface Props { lang: Lang }
const t = ui[Astro.props.lang].theme;
---
<button class="pillbtn theme" type="button" data-theme-toggle>
  <span class="theme__face theme__face--light"><Glyph name="light" size={18} strokeWidth={1.6} /><span class="theme__hidden">{t.lead}</span>{t.light}<span class="theme__hidden">{t.tail}</span></span>
  <span class="theme__face theme__face--dark"><Glyph name="dark" size={18} strokeWidth={1.6} /><span class="theme__hidden">{t.lead}</span>{t.dark}<span class="theme__hidden">{t.tail}</span></span>
</button>

<style>
  .theme { padding-left: 10px; }
  .theme__face { display: inline-flex; align-items: center; gap: 7px; }
  :global(:root[data-theme="light"]) .theme__face--light,
  :global(:root:not([data-theme="light"])) .theme__face--dark { display: none; }
  .theme__hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
