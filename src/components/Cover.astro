---
import type { Project } from '../data/work';
interface Props { project: Project; eager?: boolean }
const { project: p, eager = false } = Astro.props;
const c = p.cover;
---
<div class="cover" style={c.kind === 'image' && c.bg ? `background:${c.bg}` : undefined}>
  {c.kind === 'image' && <img src={c.src} alt={c.alt} loading={eager ? 'eager' : 'lazy'} decoding="async" class:list={[c.fit === 'contain' && 'contain']} />}

  {c.kind === 'equator' && (
    <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice">
      <defs>
        <radialGradient id="eq-bg" cx="50%" cy="110%" r="90%"><stop offset="0" stop-color="#2a2a2a"/><stop offset="1" stop-color="#050505"/></radialGradient>
        <linearGradient id="eq-line" x1="0" x2="1"><stop offset="0" stop-color="#fff" stop-opacity="0"/><stop offset=".5" stop-color="#fff" stop-opacity=".5"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></linearGradient>
      </defs>
      <rect width="400" height="300" fill="url(#eq-bg)"/>
      <rect x="0" y="149.5" width="400" height="1" fill="url(#eq-line)"/>
      <g fill="#f2ebe0" transform="translate(82 100) scale(0.62)">
        <path d="m25.03 53.3a33.6 33.6 0 0 1 66.54 0zm-0.03 9.2h66.6a33.6 33.6 0 0 1-66.6 0z"/>
        <path d="m144 60.5h-23.9c0.7 5.2 4.1 8.3 9.2 8.3 3.6 0 6.4-1.6 8.5-4l4.4 3c-2.7 4-7.1 6.2-12.9 6.2-9.3 0-15.5-6.5-15.5-15.4 0-8.8 6.3-15.4 15.1-15.4 8.9 0 15.1 6.4 15.1 15.3zm-23.8-4.6h17.6c-0.9-4.6-3.9-7-8.9-7-4.6 0-7.8 2.5-8.7 7z"/>
        <path d="m173.1 43.9h6.4v41.7h-6.4v-15.8c-2.4 2.7-5.7 4.2-10.1 4.2-8.8 0-15.1-6.7-15.1-15.4 0-8.9 6.3-15.4 15.1-15.4 4.5 0 7.7 1.5 10.1 4.2zm-9.8 5c-5.5 0-9.3 4.1-9.3 9.7 0 5.7 3.8 10.1 9.3 10.1 5.6 0 9.9-4.2 9.9-10.1 0-5.7-4.3-9.7-9.9-9.7z"/>
        <path d="m185.9 43.9h6v17.8c0 4.6 2.4 7.1 7.2 7.1 4.7 0 7.1-2.5 7.1-7.1v-17.8h6.1v18.2c0 7.8-5 11.9-13.2 11.9s-13.2-4.1-13.2-11.9z"/>
        <path d="m241.7 43.9h6v29.4h-6v-3.5c-2.5 2.7-5.8 4.2-10.1 4.2-8.8 0-15.1-6.7-15.1-15.4 0-8.9 6.3-15.4 15.1-15.4 4.3 0 7.6 1.5 10.1 4.2zm-9.7 5c-5.6 0-9.4 4.1-9.4 9.7 0 5.7 3.8 10.1 9.4 10.1s9.7-4.3 9.7-10.1c0-5.7-4.1-9.7-9.7-9.7z"/>
        <path d="m255.9 35h6.2v8.9h7.4v5.6h-7.4v14.2c0 3 1.2 3.9 4.1 3.9h3.3v5.7c-1 0.2-2.3 0.3-3.6 0.3-6.7 0-10-3.3-10-9.8v-14.3h-4.3v-5.6h4.3z"/>
        <path d="m286.8 43.2c8.9 0 15.4 6.6 15.4 15.4s-6.5 15.4-15.4 15.4-15.4-6.6-15.4-15.4 6.5-15.4 15.4-15.4zm0 5.7c-5.5 0-9.3 4.1-9.3 9.7 0 5.7 3.8 10.1 9.3 10.1 5.4 0 9.2-4.4 9.2-10.1 0-5.6-3.8-9.7-9.2-9.7z"/>
        <path d="m306.8 43.9h6.2v3.7c2.3-3.1 5.8-4.5 10.8-4.1v5.9c-6.1-0.3-10.8 3.1-10.8 8.9v15h-6.2z"/>
      </g>
      <text x="200" y="232" text-anchor="middle" font-family="Inter, system-ui" font-size="9" letter-spacing="3" fill="#8a8a8a">WORK IN PROGRESS</text>
    </svg>
  )}

  {c.kind === 'pos' && (
    <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" font-family="Inter, system-ui">
      <defs><linearGradient id="pos-bg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff3e6"/><stop offset="1" stop-color="#ffd9b8"/></linearGradient></defs>
      <rect width="400" height="300" fill="url(#pos-bg)"/>
      <rect x="44" y="34" width="312" height="252" rx="14" fill="#fff" stroke="#f0dcc8"/>
      <rect x="44" y="34" width="312" height="36" rx="14" fill="#1b1b1b"/><rect x="44" y="56" width="312" height="14" fill="#1b1b1b"/>
      <circle cx="64" cy="52" r="7" fill="#f28c28"/><text x="78" y="56" font-size="10" font-weight="600" fill="#fff">Petzone</text>
      <text x="336" y="56" font-size="8" fill="#bbb" text-anchor="end">Register 1 · Ana</text>
      {[['Dog food 12kg', '2', '$ 84.00'], ['Cat litter 10L', '1', '$ 16.50'], ['Chew toy', '3', '$ 13.50'], ['Flea collar', '1', '$ 22.00']].map(([n, q, t], i) => (
        <g transform={`translate(0 ${86 + i * 30})`}>
          <rect x="60" y="0" width="22" height="22" rx="6" fill="#fff3e6"/>
          <text x="92" y="15" font-size="9" fill="#222">{n}</text>
          <text x="228" y="15" font-size="9" fill="#888" text-anchor="end">× {q}</text>
          <text x="248" y="15" font-size="9" fill="#222">{t}</text>
        </g>
      ))}
      <rect x="276" y="86" width="64" height="112" rx="10" fill="#fbf7f2"/>
      {['1','2','3','4','5','6','7','8','9'].map((k, i) => <text x={292 + (i % 3) * 18} y={106 + Math.floor(i / 3) * 24} font-size="9" fill="#333" text-anchor="middle">{k}</text>)}
      <text x="310" y="184" font-size="8" fill="#999" text-anchor="middle">0 · ⌫</text>
      <line x1="60" y1="212" x2="340" y2="212" stroke="#f0dcc8"/>
      <text x="60" y="236" font-size="9" fill="#888">Total</text><text x="340" y="238" font-size="16" font-weight="600" fill="#111" text-anchor="end">$ 136.00</text>
      <rect x="60" y="250" width="130" height="24" rx="12" fill="#1b1b1b"/><text x="125" y="266" font-size="9" fill="#fff" text-anchor="middle" font-weight="500">Charge</text>
      <rect x="200" y="250" width="140" height="24" rx="12" fill="#fff3e6"/><text x="270" y="266" font-size="9" fill="#a05a12" text-anchor="middle" font-weight="500">Hold order</text>
    </svg>
  )}
</div>

<style>
  .cover { position: absolute; inset: 0; }
  .cover > :global(svg), .cover > :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cover :global(.contain) { object-fit: contain !important; padding: 8%; }
</style>
