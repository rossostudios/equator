---
/**
 * Monoline geometric glyphs, drawn on one 24px grid with a single stroke weight.
 * Built from a small shared vocabulary: circles, diamonds, hairlines, crosshairs
 * and dotted rings, so ten icons still read as one set.
 */
interface Props { name: keyof typeof glyphs; size?: number; class?: string }

const glyphs = {
  /** The mark itself: a disc cut by the horizon. */
  brand: `
    <circle cx="12" cy="12" r="8.4"/>
    <path d="M1.8 12h20.4"/>
    <circle cx="1.8" cy="12" r="1.3" fill="currentColor" stroke="none"/>
    <circle cx="22.2" cy="12" r="1.3" fill="currentColor" stroke="none"/>`,
  /** A screen, and the one thing on it that matters. */
  product: `
    <rect x="3.6" y="2.8" width="16.8" height="18.4" rx="2.6"/>
    <path d="M3.6 8.4h16.8"/>
    <circle cx="12" cy="15.2" r="3.2"/>
    <circle cx="6.6" cy="5.6" r="1" fill="currentColor" stroke="none"/>`,
  /** Browser chrome over a page. */
  web: `
    <rect x="2.4" y="4.6" width="19.2" height="14.8" rx="2.6"/>
    <path d="M2.4 9.2h19.2M7 13h10M7 16h6"/>
    <circle cx="5.6" cy="6.9" r=".9" fill="currentColor" stroke="none"/>`,
  /** Layers coming together, then shipping. */
  build: `
    <path d="M12 2.6 21 7.6l-9 5-9-5z"/>
    <path d="M3 12.2l9 5 9-5"/>
    <path d="M3 16.6l9 5 9-5"/>`,
  /** A tag on the shelf. */
  commerce: `
    <path d="M12.4 2.6H19a2 2 0 0 1 2 2v6.6l-9.4 9.4a1.8 1.8 0 0 1-2.5 0l-6.7-6.7a1.8 1.8 0 0 1 0-2.5z"/>
    <circle cx="16.6" cy="7" r="1.5"/>`,
  /** A panel with a tool clipped onto it. */
  extension: `
    <rect x="2.6" y="4" width="18.8" height="16" rx="2.6"/>
    <path d="M8.4 4v16"/>
    <circle cx="15" cy="12" r="2.4"/>
    <path d="M15 6.6v3M15 14.4v3"/>`,
  /** Two links holding. */
  chain: `
    <path d="M10.2 13.8 7.8 16.2a3.6 3.6 0 0 1-5.1-5.1l2.4-2.4"/>
    <path d="M13.8 10.2l2.4-2.4a3.6 3.6 0 0 1 5.1 5.1l-2.4 2.4"/>
    <path d="M9 15l6-6"/>`,
  /** Intake, status, handoff: a line with stations on it. */
  pipeline: `
    <path d="M3.4 12h17.2"/>
    <circle cx="4" cy="12" r="2"/>
    <circle cx="12" cy="12" r="2"/>
    <circle cx="20" cy="12" r="2"/>
    <path d="M12 10V6.2"/>
    <circle cx="12" cy="5" r="1.2" fill="currentColor" stroke="none"/>`,
  /** A target, and the rings a crawler reads on the way in. */
  target: `
    <circle cx="12" cy="12" r="8.6"/>
    <circle cx="12" cy="12" r="5" stroke-dasharray="1.4 2.6"/>
    <circle cx="12" cy="12" r="1.7"/>
    <path d="M12 1.4v2.6M12 20v2.6M1.4 12h2.6M20 12h2.6"/>`,
  /** Play, with the frames rushing past it. */
  motion: `
    <circle cx="13.6" cy="12" r="7.4"/>
    <path d="M11.8 9.1 16.4 12l-4.6 2.9z"/>
    <path d="M2.2 9.4h2.8M1.2 12h3.4M2.2 14.6h2.8"/>`,
} as const;

const { name, size = 30, class: cls } = Astro.props;
---
<svg
  class={cls}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={glyphs[name]}
/>
