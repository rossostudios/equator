---
/**
 * The Equator icon set. Drawn here rather than pulled from a library, so the
 * icons carry the mark instead of just sitting next to it.
 *
 * One 24px grid, one stroke weight, round caps. Every glyph is built from the
 * same two pieces as the logo: a HORIZON (a straight rule crossing the glyph)
 * and a SUN (a solid disc or half-disc). Outlines describe the object, the
 * solid is the accent, and there is never more than one solid per glyph.
 */
interface Props { name: keyof typeof glyphs; size?: number; strokeWidth?: number; class?: string }

const glyphs = {
  // ---------- Navigation ----------
  /** A roof, the horizon across it, and the sun above the line. */
  home: `
    <path d="M3.6 10.4 12 3.6l8.4 6.8V20a1 1 0 0 1-1 1H4.6a1 1 0 0 1-1-1z"/>
    <path d="M3.6 15.2h16.8"/>
    <circle cx="12" cy="12.2" r="1.7" fill="currentColor" stroke="none"/>`,
  /** The studio pass: a head above the horizon, a name line below. */
  about: `
    <rect x="4.2" y="2.6" width="15.6" height="18.8" rx="2.6"/>
    <path d="M4.2 15.4h15.6"/>
    <circle cx="12" cy="9.4" r="2.7" fill="currentColor" stroke="none"/>
    <path d="M8.4 18.4h7.2"/>`,
  /** Four blocks, one filled: the house pattern at icon size. */
  work: `
    <rect x="3" y="3" width="7.7" height="7.7" rx="1.5"/>
    <rect x="13.3" y="3" width="7.7" height="7.7" rx="1.5" fill="currentColor" stroke="none"/>
    <rect x="3" y="13.3" width="7.7" height="7.7" rx="1.5"/>
    <rect x="13.3" y="13.3" width="7.7" height="7.7" rx="1.5"/>`,
  /** Something said, and the full stop at the end of it. */
  words: `
    <path d="M21 14.2a2.6 2.6 0 0 1-2.6 2.6H9.2L4.4 20.6v-3.8A2.6 2.6 0 0 1 3 14.2V5.8A2.6 2.6 0 0 1 5.6 3.2h12.8A2.6 2.6 0 0 1 21 5.8z"/>
    <path d="M7.4 8.6h9.2"/>
    <path d="M7.4 12.2h5.4"/>
    <circle cx="16" cy="12.2" r="1.45" fill="currentColor" stroke="none"/>`,
  /** Two arcs holding, joined on the line between them. */
  links: `
    <path d="M10.3 13.7 8 16a3.75 3.75 0 0 1-5.3-5.3l2.3-2.3"/>
    <path d="M13.7 10.3 16 8a3.75 3.75 0 0 1 5.3 5.3L19 15.6"/>
    <circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"/>`,
  /** An envelope: the flap doubles as the horizon. */
  mail: `
    <rect x="2.6" y="4.8" width="18.8" height="14.4" rx="2.6"/>
    <path d="M2.6 8.6 12 14.2l9.4-5.6"/>`,

  // ---------- Services ----------
  /** The mark itself: a disc cut by the horizon, and the line running on. */
  brand: `
    <circle cx="12" cy="12" r="8.4"/>
    <path d="M1.8 12h20.4"/>
    <circle cx="12" cy="7.6" r="1.6" fill="currentColor" stroke="none"/>`,
  /** A screen, and the one thing on it that matters. */
  product: `
    <rect x="3.6" y="2.8" width="16.8" height="18.4" rx="2.6"/>
    <path d="M3.6 8.4h16.8"/>
    <circle cx="12" cy="15" r="3.2"/>
    <circle cx="6.6" cy="5.6" r="1.2" fill="currentColor" stroke="none"/>`,
  /** Browser chrome over a page. */
  web: `
    <rect x="2.4" y="4.6" width="19.2" height="14.8" rx="2.6"/>
    <path d="M2.4 9.2h19.2M7 13h10M7 16h6"/>
    <circle cx="5.6" cy="6.9" r="1.1" fill="currentColor" stroke="none"/>`,
  /** Layers stacking, then shipping. */
  build: `
    <path d="M12 2.6 21 7.6l-9 5-9-5z" fill="currentColor" stroke="none"/>
    <path d="M3 12.2l9 5 9-5"/>
    <path d="M3 16.6l9 5 9-5"/>`,
  /** A tag on the shelf. */
  commerce: `
    <path d="M12.4 2.6H19a2 2 0 0 1 2 2v6.6l-9.4 9.4a1.8 1.8 0 0 1-2.5 0l-6.7-6.7a1.8 1.8 0 0 1 0-2.5z"/>
    <circle cx="16.5" cy="7.1" r="1.5" fill="currentColor" stroke="none"/>`,
  /** A panel with a tool clipped onto it. */
  extension: `
    <rect x="2.6" y="4" width="18.8" height="16" rx="2.6"/>
    <path d="M8.4 4v16"/>
    <path d="M15 6.4v3.2M15 14.4v3.2"/>
    <circle cx="15" cy="12" r="1.9" fill="currentColor" stroke="none"/>`,
  /** A block, signed and sealed. */
  onchain: `
    <path d="M12 2.8 20.4 7.6v9.6L12 21.6 3.6 17.2V7.6z"/>
    <path d="M3.6 7.6 12 12.4l8.4-4.8"/>
    <circle cx="12" cy="12.4" r="1.6" fill="currentColor" stroke="none"/>`,
  /** Intake, status, handoff: a line with stations on it. */
  pipeline: `
    <path d="M3.4 12h17.2"/>
    <circle cx="4.2" cy="12" r="2"/>
    <circle cx="19.8" cy="12" r="2"/>
    <circle cx="12" cy="12" r="2.2" fill="currentColor" stroke="none"/>`,
  /** A target, and the rings a crawler reads on the way in. */
  target: `
    <circle cx="12" cy="12" r="8.6"/>
    <circle cx="12" cy="12" r="5" stroke-dasharray="1.4 2.6"/>
    <path d="M12 1.4v2.4M12 20.2v2.4M1.4 12h2.4M20.2 12h2.4"/>
    <circle cx="12" cy="12" r="1.7" fill="currentColor" stroke="none"/>`,
  /** Play, with the frames rushing past it. */
  motion: `
    <circle cx="13.6" cy="12" r="7.4"/>
    <path d="M11.9 9.2 16.3 12l-4.4 2.8z" fill="currentColor" stroke="none"/>
    <path d="M2.2 9.4h2.8M1.2 12h3.4M2.2 14.6h2.8"/>`,
} as const;

const { name, size = 30, strokeWidth = 1.4, class: cls } = Astro.props;
---
<svg
  class={cls}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={glyphs[name]}
/>
