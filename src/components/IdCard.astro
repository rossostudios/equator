---
// Three.js lanyard ID card. The photo lives at public/me.webp; the well is 848x900,
// so anything square or portrait covers it. Without the file the block pattern stands in.
import type { Lang } from '../i18n';
interface Props { lang?: Lang; photo?: string; name?: string; role?: string; handle?: string; number?: string }
/* The role is printed on the pass itself, so it follows the page's language. */
const words = {
  en: { role: 'Founder · Designer · Builder', hint: 'Drag to swing · click to flip' },
  es: { role: 'Fundador · Diseñador · Desarrollador', hint: 'Arrastra para mecer · toca para voltear' },
};
const { lang = 'en', photo = '/me.webp', name = 'Christopher', role = words[lang].role, handle = '@equator_chris', number = '0000001' } = Astro.props;
---
<div class="idcard" id="idcard" data-photo={photo} data-name={name} data-role={role} data-handle={handle} data-number={number} aria-label={`${name}, ${role}`} role="img">
  <canvas class="idcard__canvas"></canvas>
  <p class="idcard__hint muted">{words[lang].hint}</p>
</div>

<style>
  .idcard { position: relative; width: 100%; height: 100%; min-height: 520px; cursor: grab; user-select: none; }
  .idcard:active { cursor: grabbing; }
  /* Blank until the scene has the photo on the pass, then it fades up. */
  .idcard__canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; opacity: 0; transition: opacity .6s ease; }
  .idcard.is-ready .idcard__canvas { opacity: 1; }
  .idcard__hint { position: absolute; bottom: 8px; left: 0; right: 0; text-align: center; font-size: 12px; pointer-events: none; opacity: 0; transition: opacity .3s; }
  .idcard:hover .idcard__hint { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .idcard__canvas { transition: none; } }
</style>

<script>
  /* The scene is 559 KB of three.js (src/scripts/idcard.ts). Nothing on the page waits
     for it: it loads once the browser is idle. The photo starts downloading now, held
     here so it is already cached when the scene asks for it. */
  const photo = new Image();
  photo.src = document.getElementById('idcard')!.dataset.photo!;
  const load = () => import('../scripts/idcard');
  if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 1500 });
  else setTimeout(load, 300);
</script>
