---
// Renders a Hugeicons icon (stroke style) from @hugeicons/core-free-icons data.
type IconData = readonly (readonly [string, Record<string, string | number>])[];
interface Props { icon: IconData; size?: number; strokeWidth?: number; class?: string }
const { icon, size = 24, strokeWidth = 1.5, class: cls } = Astro.props;
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" class={cls} aria-hidden="true">
  {icon.map(([tag, attrs]) => {
    const Tag = tag as 'path';
    const { key, ...rest } = attrs as Record<string, string | number>;
    return <Tag {...rest} />;
  })}
</svg>
