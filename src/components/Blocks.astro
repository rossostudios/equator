---
/**
 * The house pattern: flat rectangular runs on a grid, hard edges, no gradients.
 * Same construction as the studio pass, so every surface speaks one language.
 *
 * mode "tile"    — one palette, square cells. A swatch.
 * mode "horizon" — the palette shifts by row, sky down to ground. A blocky sunset.
 */
interface Props {
  mode?: 'tile' | 'horizon';
  seed?: number;
  cols?: number;
  rows?: number;
  palette?: string[];
  stretch?: boolean;
  class?: string;
}

/** Sky, sun on the line, ground. Each row picks from the band it falls in. */
const HORIZON = [
  ['#c3ccff', '#8898ff', '#8898ff'],
  ['#8898ff', '#a9b4ff', '#ffb020'],
  ['#ffb020', '#ffc44d', '#ff6b1a'],
  ['#ff6b1a', '#ffb020', '#ff6b1a'],
  ['#ff6b1a', '#b4562a', '#14463a'],
  ['#14463a', '#0f332b', '#1d5645'],
  ['#0f332b', '#07120e', '#0f332b'],
];

const {
  mode = 'tile',
  seed = 7,
  cols = 8,
  rows = 8,
  palette = ['#ff6b1a', '#ffb020', '#8898ff'],
  stretch = mode === 'horizon',
  class: cls,
} = Astro.props;

// Park–Miller PRNG: deterministic, so a pattern never reshuffles between builds.
let s = (seed * 16807) % 2147483647 || 1;
const rnd = () => (s = (s * 16807) % 2147483647) / 2147483647;

const rects: { x: number; y: number; w: number; c: string }[] = [];
for (let y = 0; y < rows; y++) {
  const pool = mode === 'horizon'
    ? HORIZON[Math.min(HORIZON.length - 1, Math.floor((y / rows) * HORIZON.length))]
    : palette;
  let x = 0;
  while (x < cols) {
    const run = Math.min(cols - x, 1 + Math.floor(rnd() * 3.4));
    rects.push({ x, y, w: run, c: pool[Math.floor(rnd() * pool.length)] });
    x += run;
  }
}
---
<svg
  class={cls}
  viewBox={`0 0 ${cols} ${rows}`}
  preserveAspectRatio={stretch ? 'none' : 'xMidYMid meet'}
  shape-rendering="crispEdges"
  aria-hidden="true"
  focusable="false"
>{rects.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" fill={r.c} />)}</svg>
