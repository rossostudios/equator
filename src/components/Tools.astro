---
import { toolGroups } from '../data/tools';
import type { Lang } from '../i18n';
import { ui } from '../i18n/ui';
/** What I build with, as the booklet's parts bags: one white sheet per kind of tool, each tool's
 *  official logo on a little white brick, like the profiles in the footer. */
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<div class="toolgroups">
  {toolGroups.map((g, i) => (
    <section class="toolgroup" data-reveal style={`--d:${i % 2}`}>
      <h3 class="toolgroup__title">{g.title[lang]}</h3>
      <ul class="tools">
        {g.tools.map((t) => (
          <li>
            <a class="tool" href={t.url} target="_blank" rel="noopener noreferrer">
              <span class="tool__logo" aria-hidden="true"><img src={t.logo} alt="" width="26" height="26" loading="lazy" decoding="async" /></span>
              <span class="tool__text"><strong>{t.name[lang]}</strong><span>{t.blurb[lang]}<span class="sr-only"> {ui[lang].newTab}</span></span></span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  /* Two columns that fill top to bottom, so a short bag doesn't leave a hole beside a long one. */
  .toolgroups { columns: 2; column-gap: 20px; }
  .toolgroup { break-inside: avoid; margin-bottom: 20px; padding: 20px 22px 16px; background: #fff; border-radius: var(--radius); box-shadow: var(--shadow); }
  .toolgroup__title {
    display: flex; align-items: center; gap: 9px; margin: 0 0 10px;
    font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3);
  }
  .toolgroup__title::before { margin-top: -2px; }
  .tools { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .tool { display: flex; align-items: center; gap: 14px; padding: 8px; margin: 0 -8px; border-radius: 10px; transition: background .15s; }
  .tool:hover { background: var(--callout); }
  /* Each official logo on a white brick, which rises a step when you point at it. */
  .tool__logo {
    width: 42px; height: 42px; border-radius: 10px; display: grid; place-items: center; flex: none; color: var(--ink);
    background: #fff; box-shadow: inset 0 0 0 1.5px var(--line), inset 0 -3px 0 var(--line);
    transition: transform .2s cubic-bezier(.3, 1.6, .5, 1), box-shadow .2s;
  }
  .tool__logo img { width: 26px; height: 26px; display: block; object-fit: contain; border-radius: 6px; }
  .tool:hover .tool__logo {
    transform: translateY(-2px);
    box-shadow: inset 0 0 0 1.5px var(--line), inset 0 -4px 0 var(--line), 0 6px 12px -8px rgba(23, 25, 29, .4);
  }
  .tool__text { display: flex; flex-direction: column; min-width: 0; font-size: 14px; line-height: 1.35; }
  .tool__text span { font-size: 13px; color: var(--ink-2); }
  @media (max-width: 860px) { .toolgroups { columns: 1; } }
  @media (prefers-reduced-motion: reduce) { .tool, .tool__logo { transition: none; } }
</style>
