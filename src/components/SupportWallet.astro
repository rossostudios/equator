---
import Icon from './Icon.astro';
import { Copy01Icon, Tick02Icon, Wallet01Icon } from '../data/icons';
// Replace these with your real addresses.
const wallets = [
  { chain: 'ETH', label: 'Ethereum', address: '0x0000000000000000000000000000000000000000' },
  { chain: 'SOL', label: 'Solana', address: 'So11111111111111111111111111111111111111112' },
  { chain: 'BTC', label: 'Bitcoin', address: 'bc1q000000000000000000000000000000000000000' },
];
---
<div class="wallet" id="wallet" data-wallets={JSON.stringify(wallets)}>
  <div class="wallet__inner">
    <div class="wallet__head">
      <span class="wallet__icon"><Icon icon={Wallet01Icon} size={20} /></span>
      <div>
        <p class="wallet__title">Support the studio</p>
        <p class="muted wallet__sub">Tips go straight back into the work.</p>
      </div>
    </div>
    <div class="wallet__chains" role="tablist" aria-label="Network">
      {wallets.map((w, i) => <button class="chip" role="tab" data-chain={w.chain} aria-selected={i === 0 ? 'true' : 'false'}>{w.label}</button>)}
    </div>
    <button class="wallet__addr" id="wallet-addr" aria-live="polite" aria-label="Copy address">
      <code id="wallet-code"></code>
      <span class="wallet__copy"><span class="ic ic--copy"><Icon icon={Copy01Icon} size={18} /></span><span class="ic ic--done"><Icon icon={Tick02Icon} size={18} strokeWidth={2.2} /></span></span>
    </button>
    <p class="muted wallet__note" id="wallet-note">Tap the address to copy it.</p>
  </div>
</div>

<style>
  .wallet { position: relative; }
  .wallet__inner { display: flex; flex-direction: column; gap: 18px; }
  .wallet__head { display: flex; gap: 14px; align-items: flex-start; }
  .wallet__icon { width: 40px; height: 40px; border-radius: 12px; background: var(--fg); color: var(--bg); display: grid; place-items: center; flex: none; }
  .wallet__title { font-weight: 600; font-size: 17px; }
  .wallet__sub { font-size: 14px; }
  .wallet__chains { display: flex; gap: 4px; }
  .wallet__chains .chip[aria-selected="true"] { background: var(--fg); color: var(--bg); }
  .wallet__addr {
    display: flex; align-items: center; gap: 12px; text-align: left; width: 100%;
    background: #0d0d0d; color: #f2ebe0; border-radius: 14px; padding: 16px 16px; transition: transform .15s;
  }
  .wallet__addr:hover { transform: translateY(-1px); }
  .wallet__addr code {
    flex: 1; min-width: 0; font: 500 14px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .04em; word-break: break-all;
  }
  .wallet__addr code :global(.dim) { color: #6f6f6f; }
  .wallet__copy { position: relative; width: 36px; height: 36px; border-radius: 10px; background: rgba(255,255,255,.08); display: grid; place-items: center; flex: none; }
  .ic { grid-area: 1 / 1; display: grid; place-items: center; transition: opacity .2s, transform .2s; }
  .ic--done { opacity: 0; transform: scale(.6); color: #7CFFB2; }
  .wallet__addr.is-copied .ic--copy { opacity: 0; transform: scale(.6); }
  .wallet__addr.is-copied .ic--done { opacity: 1; transform: none; }
  .wallet__note { font-size: 13px; }
</style>

<script>
  const root = document.getElementById('wallet')!;
  const wallets = JSON.parse(root.dataset.wallets!) as { chain: string; label: string; address: string }[];
  const code = document.getElementById('wallet-code')!;
  const btn = document.getElementById('wallet-addr')!;
  const note = document.getElementById('wallet-note')!;
  const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-chain]')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const GLYPHS = '0123456789abcdefABCDEFxyzXYZ';
  let current = wallets[0];
  let raf = 0;

  // Decode animation: characters scramble then lock in left to right.
  function reveal(addr: string) {
    cancelAnimationFrame(raf);
    if (reduce) { code.textContent = addr; return; }
    const start = performance.now(), per = 28, dur = addr.length * per + 400;
    const frame = (t: number) => {
      const e = t - start; let out = '';
      for (let i = 0; i < addr.length; i++) {
        const lock = i * per + 200;
        out += e >= lock ? addr[i] : GLYPHS[(Math.random() * GLYPHS.length) | 0];
      }
      code.innerHTML = out.replace(/^(0x)/, '<span class="dim">$1</span>');
      if (e < dur) raf = requestAnimationFrame(frame); else code.innerHTML = addr.replace(/^(0x)/, '<span class="dim">$1</span>');
    };
    raf = requestAnimationFrame(frame);
  }

  async function copy(text: string) {
    try { await navigator.clipboard.writeText(text); return true; } catch {}
    try {
      const ta = document.createElement('textarea'); ta.value = text; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select(); const ok = document.execCommand('copy'); ta.remove(); return ok;
    } catch { return false; }
  }

  tabs.forEach((t) => t.addEventListener('click', () => {
    tabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
    current = wallets.find((w) => w.chain === t.dataset.chain)!;
    btn.classList.remove('is-copied'); note.textContent = 'Tap the address to copy it.';
    reveal(current.address);
  }));

  btn.addEventListener('click', async () => {
    const ok = await copy(current.address);
    if (ok) { btn.classList.add('is-copied'); note.textContent = `${current.label} address copied.`; }
    else { note.textContent = 'Copy failed. Select the address manually.'; }
    setTimeout(() => btn.classList.remove('is-copied'), 1800);
  });

  const dlg = root.closest('#tip-dialog');
  if (dlg) dlg.addEventListener('tip:open', () => { btn.classList.remove('is-copied'); note.textContent = 'Tap the address to copy it.'; reveal(current.address); });
  else new IntersectionObserver(([en], obs) => { if (en.isIntersecting) { reveal(current.address); obs.disconnect(); } }, { threshold: 0.4 }).observe(root);
</script>
